{
  "permissions": {
    "allow": [
      "Bash(bin/importmap audit)",
      "Bash(bin/rails:*)",
      "Bash(docker compose exec:*)",
      "Bash(but commit:*)",
      "Bash(but push:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path | select(startswith(env.CLAUDE_PROJECT_DIR + \"/\"))' | xargs -r bundle exec rubocop -A --force-exclusion"
          }
        ]
      }
    ]
  }
}
