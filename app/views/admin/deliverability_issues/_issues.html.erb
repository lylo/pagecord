<% if issues.any? %>
  <div class="divide-y divide-slate-200 dark:divide-slate-800">
    <% issues.each do |issue| %>
      <div class="sheet-bleed flex flex-col gap-3 py-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <span class="font-medium text-slate-900 [overflow-wrap:anywhere] dark:text-slate-100"><!--email_off--><%= issue.email %><!--/email_off--></span>
            <%= badge issue.label, deliverability_tone(issue) %>
          </div>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            <% if issue.last_seen_at %>Last seen <%= issue.last_seen_at.to_date.strftime("%-d %b %Y") %> &middot; <% end %>
            subscribed to <%= safe_join(issue.subscribers.map { |sub| link_to "@#{sub.blog.subdomain}", admin_user_path(sub.blog.user), class: "link-quiet" }, ", ") %>
          </p>
        </div>
        <%= button_to "Delete", admin_deliverability_issue_path(issue.email), method: :delete, form_class: "contents",
              data: { turbo_confirm: "Delete all #{issue.subscribers.size} #{"subscription".pluralize(issue.subscribers.size)} for #{issue.email}? This cannot be undone." },
              class: "btn-danger shrink-0 self-start" %>
      </div>
    <% end %>
  </div>
<% elsif empty_message %>
  <p class="py-8 text-center text-slate-500 dark:text-slate-400"><%= empty_message %></p>
<% end %>
