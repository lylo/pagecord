<% actionable, occasional = @issues.partition(&:actionable?) %>

<div class="flex grow flex-col">
  <h1 class="page-title">Deliverability</h1>
  <p class="mt-2 text-slate-600 dark:text-slate-300">Subscriber addresses Postmark can't deliver to.</p>

  <% if @error %>
    <div class="mt-4"><%= callout(:warning) { @error } %></div>
  <% end %>

  <section class="mt-8">
    <div class="sheet-band flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="flex items-center gap-2 font-semibold text-slate-900 dark:text-slate-100">Needs action <%= pill actionable.size %></h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Suppressed by Postmark, hard bounced or blocked, or failing <%= DeliverabilityReport::BOUNCE_THRESHOLD %> times or more
        </p>
      </div>
      <%= button_to "Delete all", admin_deliverability_purge_path, form_class: "contents",
            disabled: actionable.empty?,
            data: { turbo_confirm: "Delete every subscription for #{actionable.size} #{"address".pluralize(actionable.size)}? This cannot be undone." },
            class: "btn-danger shrink-0 self-start disabled:cursor-not-allowed disabled:opacity-50 sm:self-auto" %>
    </div>

    <%= render "issues", issues: actionable, empty_message: @issues.any? ? "Nothing needs deleting." : "No delivery problems found." %>
  </section>

  <% if occasional.any? %>
    <section class="mt-8">
      <div class="sheet-band py-4">
        <h2 class="flex items-center gap-2 font-semibold text-slate-900 dark:text-slate-100">Watching <%= pill occasional.size %></h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          Delayed or undeliverable once or twice. These usually recover, so leave them alone for now
        </p>
      </div>

      <%= render "issues", issues: occasional, empty_message: nil %>
    </section>
  <% end %>
</div>
