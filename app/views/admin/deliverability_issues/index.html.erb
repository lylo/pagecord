<% actionable, occasional = @issues.partition(&:actionable?) %>

<% if @error %>
  <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 text-sm"><%= @error %></div>
<% end %>

<div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-x-auto">
  <div class="bg-slate-50 dark:bg-slate-700/50 border-b border-slate-200 dark:border-slate-700 px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <div class="flex items-center gap-2">
        <div class="text-lg font-semibold text-slate-900 dark:text-slate-100">Needs action</div>
        <span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-700 dark:text-slate-300"><%= actionable.size %></span>
      </div>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Suppressed by Postmark, or undeliverable <%= DeliverabilityReport::BOUNCE_THRESHOLD %> times or more
      </p>
    </div>
    <%= button_to "Delete All",
        admin_deliverability_purge_path,
        disabled: actionable.empty?,
        data: { turbo_confirm: "Delete every subscription for #{actionable.size} #{"address".pluralize(actionable.size)}? This cannot be undone." },
        class: "btn-danger py-1.5 whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed" %>
  </div>

  <%= render "table", issues: actionable, empty_message: @issues.any? ? "Nothing needs deleting." : "No delivery problems found." %>
</div>

<% if occasional.any? %>
  <div class="mt-8 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-x-auto">
    <div class="bg-slate-50 dark:bg-slate-700/50 border-b border-slate-200 dark:border-slate-700 px-6 py-4">
      <div class="flex items-center gap-2">
        <div class="text-lg font-semibold text-slate-900 dark:text-slate-100">Watching</div>
        <span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-700 dark:text-slate-300"><%= occasional.size %></span>
      </div>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Undeliverable once or twice. A full mailbox usually recovers, so leave these alone for now
      </p>
    </div>

    <%= render "table", issues: occasional, empty_message: nil %>
  </div>
<% end %>
