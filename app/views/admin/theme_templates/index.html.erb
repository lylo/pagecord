<div class="flex grow flex-col">
  <h1 class="page-title">Theme templates</h1>

  <div class="mt-3 flex flex-wrap items-center gap-2">
    <%= link_to "New template", new_admin_theme_template_path, class: "btn-primary" %>
    <%= link_to "Download as fixtures", admin_theme_templates_fixtures_path, class: "btn-optional" %>
  </div>

  <div class="sheet-divider mt-5"></div>

  <div class="divide-y divide-slate-200 dark:divide-slate-800"
       data-controller="sortable"
       data-sortable-resource-name-value="theme_template"
       data-sortable-handle-value=".handle"
       data-sortable-animation-value="150">
    <% @templates.each do |template| %>
      <div class="sheet-bleed flex items-center gap-3 py-3"
           data-id="<%= template.id %>"
           data-sortable-update-url="<%= admin_theme_template_path(template) %>">
        <div class="handle cursor-grab" title="Drag to reorder">
          <%= inline_svg_tag "icons/grip-dots.svg", class: "h-4 w-4 text-slate-400" %>
        </div>
        <div class="min-w-0 flex-1">
          <%= link_to template.name, edit_admin_theme_template_path(template), class: "font-medium text-slate-900 hover:underline dark:text-slate-100" %>
          <p class="text-sm text-slate-500 dark:text-slate-400"><%= [ template.theme, template.font ].compact_blank.join(" · ").presence || "–" %></p>
        </div>
        <%= template.active? ? badge("Active", :success) : badge("Inactive") %>
      </div>
    <% end %>
  </div>
</div>
