<% periods = { nil => [ "All", @total_count ], "today" => [ "Today", @today_count ], "week" => [ "This week", @week_count ] } %>

<div class="flex grow flex-col">
  <h1 class="page-title">Posts</h1>

  <div class="mt-3">
    <div class="btn-group">
      <% periods.each do |period, (label, count)| %>
        <%= link_to admin_posts_path(period: period), class: class_names("btn-group-item", "btn-group-item-active": params[:period].presence == period) do %>
          <%= label %> <%= pill number_with_delimiter(count) %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="sheet-divider mt-5"></div>

  <div class="divide-y divide-slate-200 dark:divide-slate-800">
    <% @posts.each do |post| %>
      <div class="sheet-bleed flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
        <div class="min-w-0">
          <%= link_to post.display_title, post_url(post), target: "_blank", rel: "noopener",
                class: "font-medium text-slate-900 hover:underline [overflow-wrap:anywhere] dark:text-slate-100" %>
          <p class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">
            <%= link_to "@#{post.blog.subdomain}", admin_user_path(post.blog.user), class: "link-quiet" %>
            <% if post.blog.custom_domain.present? %>&middot; <%= post.blog.custom_domain %><% end %>
          </p>
        </div>
        <p class="shrink-0 text-sm text-slate-500 dark:text-slate-400"><%= post.published_at.strftime("%-d %b %Y %H:%M") %></p>
      </div>
    <% end %>
  </div>

  <%= render "app/shared/pagy_nav" %>
</div>
