<section class="mt-8">
  <div class="sheet-band py-3">
    <h2 class="font-semibold text-slate-900 dark:text-slate-100"><%= title %></h2>
    <% if local_assigns[:subtitle] %>
      <p class="text-sm text-slate-500 dark:text-slate-400"><%= subtitle %></p>
    <% end %>
  </div>

  <% if items.any? %>
    <% max_count = items.first[:count] %>
    <ol class="divide-y divide-slate-200 dark:divide-slate-800">
      <% items.each_with_index do |item, index| %>
        <li class="sheet-bleed flex items-start justify-between gap-3 py-3">
          <div class="flex min-w-0 flex-1 items-start gap-3">
            <span class="mt-0.5 w-6 shrink-0 text-center font-mono text-sm text-slate-400"><%= index + 1 %></span>
            <div class="min-w-0 flex-1">
              <%= link_to item[:name], item[:url], target: "_blank", rel: "noopener", class: "block truncate font-medium text-slate-900 hover:underline dark:text-slate-100" %>
              <p class="truncate text-xs text-slate-500 dark:text-slate-400">
                <%= link_to item[:subtitle], item[:subtitle_url], target: "_blank", rel: "noopener", class: "hover:underline" %>
                <% if item[:meta] %>&middot; <%= item[:meta] %><% end %>
              </p>
            </div>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <div class="hidden h-2 w-20 rounded-full bg-slate-200 md:block dark:bg-slate-700">
              <div class="h-2 rounded-full bg-pagecord-accent" style="width: <%= (item[:count].to_f / max_count * 100).round(1) %>%"></div>
            </div>
            <span class="min-w-12 text-right text-sm font-semibold tabular-nums text-slate-900 dark:text-slate-100"><%= number_with_delimiter(item[:count].to_i) %></span>
          </div>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="py-8 text-center text-slate-500 dark:text-slate-400"><%= empty_message %></p>
  <% end %>
</section>
