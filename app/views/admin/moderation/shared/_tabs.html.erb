<% tabs = [
  [ "Blogs", admin_moderation_blogs_path, "blogs", blogs_to_review_count, "moderation_tab_count" ],
  [ "Content", admin_moderation_content_index_path, "content", content_moderation_count, nil ],
  [ "Screening", admin_moderation_screenings_path, "screenings", 0, nil ]
] %>

<div class="sheet-header gap-x-6 overflow-x-auto">
  <% tabs.each do |label, path, name, count, count_id| %>
    <% current = controller_name == name %>
    <%= link_to path, aria: { current: ("page" if current) },
          class: class_names("flex shrink-0 items-center gap-1.5 hover:text-slate-900 dark:hover:text-slate-100", "font-semibold text-slate-900 dark:text-slate-100": current) do %>
      <%= label %>
      <span id="<%= count_id %>"><%= pill count if count.positive? %></span>
    <% end %>
  <% end %>
</div>
