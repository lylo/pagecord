<div class="sheet flex grow flex-col">
  <%= render "admin/moderation/shared/tabs" %>

  <h1 class="mt-6 page-title">Blank blogs</h1>
  <p class="mt-2 text-slate-600 dark:text-slate-300">Blogs with nothing on them yet. Each one joins the review queue when it publishes something.</p>

  <div class="sheet-divider mt-5"></div>

  <% if @reviews.any? %>
    <div class="divide-y divide-slate-200 dark:divide-slate-800">
      <%= render partial: "admin/moderation/blogs/review", collection: @reviews, locals: { reviewable: false } %>
    </div>

    <%= render "app/shared/pagy_nav" %>
  <% else %>
    <div class="flex grow flex-col items-center justify-center py-16 text-center">
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">No blank blogs</h2>
      <p class="mt-2 text-slate-600 dark:text-slate-300">Every blog has something on it.</p>
    </div>
  <% end %>
</div>
