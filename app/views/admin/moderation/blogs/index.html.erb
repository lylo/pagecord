<div class="flex grow flex-col">
  <%= render "admin/moderation/shared/tabs" %>

  <h1 class="mt-6 page-title">Blogs to review</h1>

  <div class="-mx-4 mt-3 max-w-[calc(100%+2rem)] overflow-x-auto px-4 sm:mx-0 sm:max-w-full sm:px-0">
    <div class="btn-group w-max whitespace-nowrap">
      <% Admin::ModerationHelper::QUEUE_FILTER_LABELS.each do |filter, label| %>
        <%= link_to admin_moderation_blogs_path(filter: (filter unless filter == "all")),
              class: class_names("btn-group-item", "btn-group-item-active": queue_filter == filter) do %>
          <%= label %> <%= pill queue_counts[filter] %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="sheet-divider mt-5"></div>

  <% if @reviews.any? %>
    <div class="divide-y divide-slate-200 dark:divide-slate-800">
      <%= render partial: "review", collection: @reviews %>
    </div>

    <%= render "app/shared/pagy_nav" %>
  <% else %>
    <div class="flex grow flex-col items-center justify-center py-16 text-center">
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">Nothing to review</h2>
      <p class="mt-2 text-slate-600 dark:text-slate-300">
        <%= queue_filter == "all" ? "Every new blog has been looked at." : "No blogs to review match this filter." %>
      </p>
      <% unless queue_filter == "all" %>
        <%= link_to "Show all", admin_moderation_blogs_path, class: "btn-optional mt-6" %>
      <% end %>
    </div>
  <% end %>
</div>
