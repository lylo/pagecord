<div id="moderation_filters" class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-3">
  <div class="-mx-4 max-w-[calc(100%+2rem)] overflow-x-auto px-4 sm:mx-0 sm:max-w-full sm:px-0">
    <div class="btn-group w-max whitespace-nowrap">
      <% Admin::ModerationHelper::QUEUE_FILTER_LABELS.each do |filter, label| %>
        <%= link_to admin_moderation_blogs_path(filter: (filter unless filter == "all")),
              class: class_names("btn-group-item", "btn-group-item-active": queue_filter == filter) do %>
          <%= label %> <%= pill queue_counts[filter] %>
        <% end %>
      <% end %>
    </div>
  </div>

  <p class="hidden text-xs text-slate-500 dark:text-slate-400 md:pointer-fine:block">
    <% { "j k" => "move", "n" => "not spam", "s" => "spam", "r" => "remove", "o" => "open" }.each do |keys, action| %>
      <span class="me-2 whitespace-nowrap"><% keys.split.each do |key| %><kbd class="rounded border border-slate-300 px-1 font-sans dark:border-slate-700"><%= key %></kbd> <% end %><%= action %></span>
    <% end %>
  </p>
</div>
