<% blog = review.blog %>
<% user = review.user %>
<% filter = { filter: (queue_filter unless queue_filter == "all") } %>

<article id="<%= dom_id(blog) %>" class="sheet-bleed scroll-mt-4 py-5 data-selected:shadow-[inset_3px_0_0_var(--color-pagecord-accent)]" data-moderation-queue-target="row">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-6">
    <div class="min-w-0 flex-1 space-y-3">
      <div>
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <%= link_to blog_home_url(blog), target: "_blank", rel: "noopener", data: { shortcut: "open" },
                class: "inline-flex items-center gap-1 text-lg font-semibold text-slate-900 hover:underline dark:text-slate-100" do %>
            @<%= blog.subdomain %>
            <%= inline_svg_tag "icons/arrow-top-right-on-square.svg", class: "h-3.5 w-3.5 text-slate-400" %>
          <% end %>
          <%= badge "Paid", :success if user.subscribed? %>
          <%= badge "Unverified", :warning unless user.verified? %>
        </div>

        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          <%= time_ago_in_words(blog.created_at) %> ago
          &middot; <%= review.email_domain %>
          &middot; <%= user.timezone %>
          &middot; via <%= signup_source(user) %>
          &middot; <%= link_to "account", admin_user_path(user), class: "link-quiet" %>
        </p>
      </div>

      <% if blog.title.present? || blog.bio.present? %>
        <div>
          <% if blog.title.present? %>
            <p class="font-medium text-slate-900 dark:text-slate-100"><%= blog.title %></p>
          <% end %>
          <% if blog.bio.present? %>
            <p class="line-clamp-3 text-slate-600 dark:text-slate-300"><%= blog.bio.to_plain_text.squish %></p>
          <% end %>
        </div>
      <% end %>

      <% flags = review_flags(review) %>
      <% if flags.any? %>
        <div class="flex flex-wrap gap-1.5">
          <% flags.each do |text, tone| %>
            <%= badge text, tone %>
          <% end %>
        </div>
      <% end %>

      <% if review.latest_posts.any? %>
        <div class="divide-y divide-slate-200 rounded-lg bg-slate-50 dark:divide-slate-800 dark:bg-slate-800/60">
          <% review.latest_posts.each do |post| %>
            <div class="px-4 py-3">
              <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                <%= link_to post.display_title, post_url(post), target: "_blank", rel: "noopener",
                      class: "font-medium text-slate-900 hover:underline [overflow-wrap:anywhere] dark:text-slate-100" %>
                <span class="text-xs text-slate-500 dark:text-slate-400"><%= time_ago_in_words(post.published_at) %> ago</span>
                <% if post.content_moderation&.flagged? %>
                  <%= badge "Flagged: #{post.content_moderation.flagged_categories.to_sentence}", :danger %>
                <% elsif !post.content_moderation&.clean? %>
                  <%= badge "Not checked yet" %>
                <% end %>
              </div>
              <% if post.text_summary.present? %>
                <p class="mt-1 text-sm text-slate-600 [overflow-wrap:anywhere] dark:text-slate-300"><%= post.text_summary.truncate(240, separator: /\s/) %></p>
              <% end %>
              <% if (hosts = review.hosts_for(post)).any? %>
                <p class="mt-1 font-mono text-xs text-slate-500 [overflow-wrap:anywhere] dark:text-slate-400">&rarr; <%= hosts.keys.join(", ") %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <p class="text-sm text-slate-500 dark:text-slate-400">
        <% if review.published_count.zero? %>
          No published posts<%= ", #{pluralize(review.draft_count, "draft")}" if review.draft_count.positive? %>
        <% else %>
          <%= pluralize(review.published_count, "published post") %><%= ", #{pluralize(review.draft_count, "draft")}" if review.draft_count.positive? %>
        <% end %>
      </p>

      <% if review.link_hosts.any? %>
        <ul class="flex flex-wrap gap-1.5 font-mono text-xs">
          <% review.link_hosts.each do |host, count| %>
            <li class="rounded bg-slate-100 px-1.5 py-0.5 text-slate-600 dark:bg-slate-800 dark:text-slate-300"><%= host %><%= " ×#{count}" if count > 1 %></li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <div class="grid grid-cols-3 gap-2 sm:flex sm:w-28 sm:shrink-0 sm:flex-col">
      <%= button_to "Not spam", admin_moderation_blog_review_path(blog, filter), form_class: "contents",
            class: "btn-primary justify-center", data: { shortcut: "not-spam" } %>
      <%= button_to "Spam", admin_moderation_blog_spam_confirmation_path(blog, filter), form_class: "contents",
            class: "btn-danger justify-center", data: { shortcut: "spam", turbo_confirm: "Confirm @#{blog.subdomain} as spam? This discards the user and cancels any subscription." } %>
      <%= button_to "Remove", admin_moderation_blog_removal_path(blog, filter), form_class: "contents",
            class: "btn-optional justify-center", data: { shortcut: "remove", turbo_confirm: "Remove @#{blog.subdomain}? This discards the user without marking it as spam." } %>
    </div>
  </div>
</article>
