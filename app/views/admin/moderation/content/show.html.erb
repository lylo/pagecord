<% moderation = @post.content_moderation %>

<div class="sheet flex grow flex-col">
  <div class="sheet-header gap-x-2">
    <%= link_to "Moderation", admin_moderation_content_index_path, class: "shrink-0 font-semibold text-slate-800 hover:underline dark:text-slate-100" %>
    <span class="shrink-0 text-slate-400">&rsaquo;</span>
    <span class="min-w-0 truncate"><%= @post.display_title %></span>
  </div>

  <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
    <div class="min-w-0">
      <h1 class="page-title [overflow-wrap:anywhere]">
        <%= link_to post_url(@post), target: "_blank", rel: "noopener", class: "hover:underline" do %>
          <%= @post.display_title %><%= inline_svg_tag "icons/arrow-top-right-on-square.svg", class: "ms-2 inline h-5 w-5 align-baseline text-slate-400" %>
        <% end %>
      </h1>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
        <%= link_to "@#{@post.blog.subdomain}", blog_home_url(@post.blog), target: "_blank", rel: "noopener", class: "link-quiet" %>
        &middot; <%= link_to "account", admin_user_path(@post.blog.user), class: "link-quiet" %>
        <% if moderation&.moderated_at %>&middot; flagged <%= moderation.moderated_at.to_formatted_s(:long) %><% end %>
      </p>
      <div class="mt-3 flex flex-wrap gap-1.5">
        <%= badge "Discarded", :danger if @post.discarded? %>
        <% moderation&.flagged_categories&.each do |category| %>
          <%= badge "#{category} · #{(moderation.category_scores[category].to_f * 100).round}%", :danger %>
        <% end %>
      </div>
    </div>

    <%= render "admin/moderation/content/actions", post: @post %>
  </div>

  <div class="sheet-divider mt-5"></div>

  <div class="prose mt-6 max-w-none dark:prose-invert">
    <%= @post.content.body %>
  </div>
</div>
