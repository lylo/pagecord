<div class="flex grow flex-col">
  <%= render "admin/moderation/shared/tabs" %>

  <h1 class="mt-6 page-title">Flagged posts</h1>
  <p class="mt-2 text-slate-600 dark:text-slate-300">Published posts content moderation flagged. They stay visible until you act.</p>

  <div class="sheet-divider mt-5"></div>

  <% if @posts.any? %>
    <div class="divide-y divide-slate-200 dark:divide-slate-800">
      <% @posts.each do |post| %>
        <% moderation = post.content_moderation %>
        <article class="sheet-bleed py-5">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-6">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                <%= link_to post.display_title, admin_moderation_content_path(post),
                      class: "font-semibold text-slate-900 hover:underline [overflow-wrap:anywhere] dark:text-slate-100" %>
                <%= badge "Discarded", :danger if post.discarded? %>
              </div>
              <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                <%= link_to "@#{post.blog.subdomain}", blog_home_url(post.blog), target: "_blank", rel: "noopener", class: "link-quiet" %>
                &middot; flagged <%= time_ago_in_words(moderation.moderated_at) %> ago
              </p>
              <div class="mt-2 flex flex-wrap gap-1.5">
                <% moderation.flagged_categories.each do |category| %>
                  <%= badge "#{category} · #{(moderation.category_scores[category].to_f * 100).round}%", :danger %>
                <% end %>
              </div>
              <% if post.text_summary.present? %>
                <p class="mt-2 text-sm text-slate-600 [overflow-wrap:anywhere] dark:text-slate-300"><%= post.text_summary.truncate(240, separator: /\s/) %></p>
              <% end %>
            </div>

            <%= render "admin/moderation/content/actions", post: post %>
          </div>
        </article>
      <% end %>
    </div>

    <%= render "app/shared/pagy_nav" %>
  <% else %>
    <div class="flex grow flex-col items-center justify-center py-16 text-center">
      <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100">Nothing flagged</h2>
      <p class="mt-2 text-slate-600 dark:text-slate-300">Content moderation hasn't flagged any published posts.</p>
    </div>
  <% end %>
</div>
