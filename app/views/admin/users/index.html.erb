<% statuses = { nil => "All", "paid" => "Paid", "supporter" => "Supporters", "comped" => "Comped", "churning" => "Churning" } %>

<div class="flex grow flex-col" data-controller="search">
  <div class="sheet-header gap-x-3">
    <%= form_with url: admin_users_path, method: :get, class: "relative grow",
          data: { turbo_frame: "users", turbo_action: "advance", search_target: "form" } do |form| %>
      <%= form.search_field :search, value: params[:search], placeholder: "Search subdomain, domain, email or Paddle ID",
            class: "form-field w-full py-1.5 ps-3 pe-9 text-sm", aria: { label: "Search users" },
            data: { action: "input->search#search", search_target: "input" } %>
      <%= form.hidden_field :status, value: params[:status] %>
    <% end %>

    <%= link_to new_admin_user_path, class: "btn-icon shrink-0", title: "New user", aria: { label: "New user" } do %>
      <%= inline_svg_tag "icons/plus.svg", class: "h-5 w-5" %>
    <% end %>
  </div>

  <h1 class="mt-6 page-title">Users</h1>

  <div class="-mx-4 mt-3 overflow-x-auto px-4 sm:mx-0 sm:px-0">
    <div class="btn-group">
      <% statuses.each do |status, label| %>
        <%= link_to admin_users_path(status: status, search: params[:search].presence),
              class: class_names("btn-group-item", "btn-group-item-active": params[:status].presence == status) do %>
          <%= label %> <%= pill number_with_delimiter(@status_counts[status]) %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="sheet-divider mt-5"></div>

  <%= turbo_frame_tag "users", class: "flex grow flex-col", data: { turbo_action: "advance" } do %>
    <% if params[:search].present? %>
      <p class="pt-4 text-sm text-slate-500 dark:text-slate-400">
        <%= pluralize(@pagy.count, "result") %> for “<%= params[:search] %>”
        &middot; <%= link_to "clear", admin_users_path(status: params[:status].presence), class: "link-quiet", data: { turbo_frame: "_top" } %>
      </p>
    <% end %>

    <div class="divide-y divide-slate-200 dark:divide-slate-800">
      <% @users.each do |user| %>
        <div class="sheet-bleed flex flex-col gap-1 py-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
              <%= link_to user.email, admin_user_path(user), data: { turbo_frame: "_top" },
                    class: "font-semibold text-slate-900 hover:underline [overflow-wrap:anywhere] dark:text-slate-100" %>
              <%= account_status_badge(user) %>
              <%= badge "Unverified", :warning unless user.verified? %>
            </div>
            <ul class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-500 dark:text-slate-400">
              <% user.blogs.each do |blog| %>
                <li>
                  <%= link_to blog.subdomain, blog_home_url(blog), target: "_blank", rel: "noopener", class: "link-quiet text-slate-700 dark:text-slate-200" %>
                  <% if blog.custom_domain.present? %>&middot; <%= blog.custom_domain %><% end %>
                  &middot; <%= pluralize(@post_counts_by_blog_id.fetch(blog.id, 0), "post") %>
                </li>
              <% end %>
            </ul>
          </div>
          <p class="shrink-0 text-sm text-slate-500 dark:text-slate-400">
            <% subscribed_view = %w[paid supporter].include?(params[:status]) %>
            <%= subscribed_view ? "Subscribed" : "Joined" %> <%= (subscribed_view ? user.subscription.created_at : user.created_at).to_date.to_fs(:long) %>
          </p>
        </div>
      <% end %>
    </div>

    <% if @users.empty? %>
      <p class="py-12 text-center text-slate-500 dark:text-slate-400">No users found.</p>
    <% end %>

    <%= render "app/shared/pagy_nav" %>
  <% end %>
</div>
