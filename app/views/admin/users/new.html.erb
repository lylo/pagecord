<div class="sheet-header gap-x-2">
  <%= link_to "Users", admin_users_path, class: "shrink-0 font-semibold text-slate-800 hover:underline dark:text-slate-100" %>
  <span class="shrink-0 text-slate-400">&rsaquo;</span>
  <span class="min-w-0 truncate">New user</span>
</div>

<h1 class="mt-6 page-title">New user</h1>

<%= form_with(model: [ :admin, @user ], class: "mt-6 max-w-lg space-y-5") do |form| %>
  <% if @user.errors.any? %>
    <%= callout(:warning) do %>
      <ul class="list-disc space-y-1 ps-5">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <%= form.fields_for :blogs do |blog_form| %>
    <div>
      <%= blog_form.label :subdomain, "Subdomain", class: "mb-1 block text-sm font-medium" %>
      <%= blog_form.text_field :subdomain, placeholder: "subdomain", autofocus: true, maxlength: 20, required: true, class: "form-field w-full" %>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Letters and numbers only</p>
    </div>
  <% end %>

  <div>
    <%= form.label :email, class: "mb-1 block text-sm font-medium" %>
    <%= form.email_field :email, placeholder: "you@example.com", required: true, class: "form-field w-full" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.submit "Create user", class: "btn-primary" %>
    <%= link_to "Cancel", admin_users_path, class: "btn-optional" %>
  </div>
<% end %>
