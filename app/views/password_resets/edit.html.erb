<% content_for :title, "Pagecord - Set a new password" %>

<%= form_with url: password_reset_path(params[:token]), model: @user, method: :patch, class: "letter-form", data: { turbo: false } do |form| %>
  <div class="letter-paper">
    <%= render "letters/letterhead" %>

    <p>Dear Pagecord,</p>
    <p>
      Please change the password for <%= @user.blog.subdomain %>.pagecord.com to
      <%= letter_blank form, :password, label: "New password", as: :password_field, period: true, required: true, autofocus: true, minlength: 12, autocomplete: "new-password" %>
    </p>
    <p>
      Once more, to be sure:
      <%= letter_blank form, :password_confirmation, label: "Confirm new password", as: :password_field, period: true, required: true, autocomplete: "new-password" %>
    </p>
    <p class="letter-note" role="alert"><%= @user.errors.full_messages.first %></p>

    <p>Yours,</p>
    <p class="letter-signature"><%= @user.blog.display_name %></p>

    <div class="letter-send">
      <%= render "letters/send", form: form, label: "Change my password" %>
      <span>At least 12 characters.</span>
    </div>
  </div>
<% end %>
