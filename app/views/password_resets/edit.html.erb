<% content_for :title, "Pagecord - Set a new password" %>

<%= form_with url: password_reset_path(params[:token]), model: @user, method: :patch, class: "letter-form", data: { turbo: false } do |form| %>
  <div class="letter-paper">
    <%= render "letters/letterhead" %>

    <p>Dear Pagecord,</p>
    <p>
      Please change the password for <%= @user.blog.subdomain %>.pagecord.com to
      <span class="letter-field">
        <%= form.label :password, "New password", class: "sr-only" %>
        <%= form.password_field :password, required: true, autofocus: true, minlength: 12, autocomplete: "new-password", class: "letter-blank letter-blank--password" %><span class="letter-trail">.</span>
      </span>
    </p>
    <p>
      Once more, to be sure:
      <span class="letter-field">
        <%= form.label :password_confirmation, "Confirm new password", class: "sr-only" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "letter-blank letter-blank--password" %><span class="letter-trail">.</span>
      </span>
    </p>
    <p class="letter-note" role="alert"><%= @user.errors.full_messages.first %></p>

    <p>Yours,</p>
    <p class="letter-signature"><%= @user.blog.display_name %></p>

    <div class="letter-send">
      <%= form.button type: "submit", class: "btn-primary" do %>
        Change my password
        <%= inline_svg_tag "icons/paper-airplane.svg", class: "w-5 h-5" %>
      <% end %>
      <span>At least 12 characters.</span>
    </div>
  </div>
<% end %>
