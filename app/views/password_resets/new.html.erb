<% content_for :title, "Pagecord - Reset your password" %>
<% content_for :meta_description, "Reset your Pagecord password. Enter your email to receive a password reset link." %>

<%= form_with url: password_resets_path, model: @user, class: "letter-form", data: { turbo: false, controller: "signature" } do |form| %>
  <%= render "/shared/spam_prevention" %>

  <div class="letter-paper">
    <%= render "letters/letterhead" %>

    <p>Dear Pagecord,</p>
    <p>
      I've lost my password for
      <span class="letter-field">
        <%= form.label :subdomain, "Subdomain", class: "sr-only" %>
        <%= form.text_field :subdomain,
            placeholder: "subdomain",
            maxlength: Subdomain::MAX_LENGTH,
            required: true,
            autofocus: true,
            autocapitalize: "none",
            spellcheck: false,
            class: "letter-blank letter-blank--subdomain",
            data: { signature_target: "source", action: "input->signature#sign" } %><span>.pagecord.com.</span>
      </span>
    </p>
    <p>
      Please send a reset link to
      <span class="letter-field">
        <%= form.label :email, "Email", class: "sr-only" %>
        <%= form.email_field :email, placeholder: "your email", required: true, autocomplete: "email", class: "letter-blank letter-blank--email" %><span class="letter-trail">.</span>
      </span>
    </p>

    <p>Yours,</p>
    <p class="letter-signature" data-signature-target="output"></p>

    <div class="letter-send">
      <%= render "/shared/turnstile", theme: "auto", appearance: "interaction-only" %>
      <%= form.button type: "submit", class: "btn-primary" do %>
        Send me a reset link
        <%= inline_svg_tag "icons/paper-airplane.svg", class: "w-5 h-5" %>
      <% end %>
      <span class="letter-aside"><%= link_to "Never mind, I remember it", login_path(mode: :password) %></span>
    </div>
  </div>
<% end %>
