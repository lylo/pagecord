<section class="mt-20 mb-16 md:mb-24 mx-auto max-w-2xl px-4 flex flex-col items-center gap-8 text-center">
  <p class="home-postscript">
    P.S. I make Pagecord in Edinburgh. Write to <%= mail_to "hello@pagecord.com" %> and it's me who writes back.
    <span class="home-postscript__signature">Olly</span>
  </p>

  <%= link_to new_signup_path, class: "btn-primary gap-2.5 text-lg px-7 py-3" do %>
    Start my blog
    <%= inline_svg_tag "icons/paper-airplane.svg", class: "w-5 h-5" %>
  <% end %>

  <p class="md:text-lg leading-relaxed text-slate-600 dark:text-slate-300">
    Pagecord is bootstrapped, profitable, privacy-conscious, and <a href="https://github.com/lylo/pagecord" class="home-link">open source</a>. Take a look under the hood, suggest improvements, or host it yourself.
  </p>
</section>
