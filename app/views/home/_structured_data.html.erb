<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Pagecord",
  "url": "https://pagecord.com",
  "description": "A personal site and blog. Focus on writing, not wrangling. Publish from the editor, Obsidian, iA Writer, or just by sending an email.",
  "applicationCategory": "BloggingApplication",
  "operatingSystem": "Any (web-based)",
  "offers": [
    {
      "@type": "Offer",
      "name": "Classic",
      "price": "0",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Premium (Annual)",
      "price": "<%= Subscription.price(:annual) %>",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "billingDuration": "P1Y"
      }
    },
    {
      "@type": "Offer",
      "name": "Premium (Monthly)",
      "price": "<%= Subscription.price(:monthly) %>",
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "billingDuration": "P1M"
      }
    }
  ]
}
</script>
