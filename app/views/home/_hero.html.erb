<section class="-mt-8 pb-8 sm:px-4 sm:pt-6 md:pt-10 md:pb-10 sm:bg-pagecord-accent/10 sm:dark:bg-slate-950">
  <div class="sheet sm:[--sheet-padding:--spacing(12)] sm:pb-12 mx-auto max-w-7xl flex flex-col gap-12">
    <div class="relative overflow-hidden sheet-bleed -mt-(--sheet-padding) pt-(--sheet-padding) -mb-12 pb-12 sm:rounded-t-lg">
      <div class="flex flex-col gap-6 lg:max-w-[55%]">
      <h1 class="max-w-3xl source-serif font-semibold text-5xl md:text-7xl tracking-tight leading-[1.02] text-slate-900 dark:text-slate-100">
        Make yourself a <span class="inline bg-[linear-gradient(180deg,transparent_68%,rgb(79_189_156_/_0.45)_68%,rgb(79_189_156_/_0.45)_92%,transparent_92%)] [box-decoration-break:clone] px-1 -mx-1">home</span> on the web
      </h1>

      <div class="max-w-2xl flex flex-col gap-4 text-lg md:text-xl leading-relaxed text-slate-600 dark:text-slate-300">
        <p class="mb-2 source-serif font-medium text-2xl md:text-3xl leading-snug tracking-tight text-slate-900 dark:text-slate-100">A personal site and blog. Focus on writing, not wrangling.</p>

        <p>Publish when you like, from wherever you like: the built-in editor, iA Writer, Obsidian, or just by sending an email.</p>
      </div>

      <%= render "home/letter" %>

      <p class="text-sm"><%= link_to "See real Pagecord sites", spotlight_path, class: "home-link" %></p>

      <p class="max-w-xl text-sm text-slate-500 dark:text-slate-400">
        Every account starts with 14 days of Premium. Keep it for $<%= localised_price %> a year, or stay on Classic for free. Already writing somewhere else? We'll <%= link_to "bring your old posts across", "https://help.pagecord.com/importing-an-existing-blog", class: "home-link" %>.
      </p>
      </div>

      <picture class="contents">
        <source srcset="<%= home_image_path("home/harbourlight-home-dark.webp", width: 1000, quality: 88) %>" media="(prefers-color-scheme: dark)">
        <%= image_tag home_image_path("home/harbourlight-home.webp", width: 1000, quality: 88),
              alt: "",
              width: "1320",
              height: "2800",
              class: "hidden lg:block absolute top-8 left-[60%] w-[32rem] max-w-none origin-top-left -rotate-6 rounded-lg shadow-2xl ring-1 ring-slate-900/10 dark:ring-white/10" %>
      </picture>
    </div>

    <div class="sheet-divider"></div>

    <%= render "home/corner" %>
  </div>

  <p class="mt-5 px-4 text-center text-sm text-slate-500 dark:text-slate-400">Trusted by 1,200+ writers &middot; Pagecord is independent and open source</p>
</section>
