        </li>
        <li class="flex items-center text-slate-700 dark:text-slate-300">
          <%= inline_svg_tag "icons/check.svg", class: "w-5 h-5 text-green-500 mr-3" %>
          Comments
        </li>
        <li class="flex items-center text-slate-700 dark:text-slate-300">
          <%= inline_svg_tag "icons/check.svg", class: "w-5 h-5 text-green-500 mr-3" %>
          Reply by email
        </li>
        <li class="flex items-center text-slate-700 dark:text-slate-300">
          <%= inline_svg_tag "icons/check.svg", class: "w-5 h-5 text-green-500 mr-3" %>
          Embeddable contact form
        </li>
        <li class="flex items-center text-slate-700 dark:text-slate-300">
          <%= inline_svg_tag "icons/check.svg", class: "w-5 h-5 text-green-500 mr-3" %>
          Three blogs from one account
        </li>
        <li class="flex items-center text-slate-700 dark:text-slate-300">
          <%= inline_svg_tag "icons/check.svg", class: "w-5 h-5 text-green-500 mr-3" %>
          Custom CSS
        </li>
        <li class="flex items-center text-slate-700 dark:text-slate-300">
          <%= inline_svg_tag "icons/check.svg", class: "w-5 h-5 text-green-500 mr-3" %>
          Custom code
        </li>
        <li class="flex items-center text-slate-700 dark:text-slate-300">
          <%= inline_svg_tag "icons/check.svg", class: "w-5 h-5 text-green-500 mr-3" %>
          API, Obsidian &amp; Shortcuts
        </li>
        <li class="flex items-center text-slate-700 dark:text-slate-300">
          <%= inline_svg_tag "icons/check.svg", class: "w-5 h-5 text-green-500 mr-3" %>
          Support independent software
        </li>
      </ul>
    </div>
  </div>

  <p class="mt-8 text-center md:text-lg leading-relaxed text-slate-600 dark:text-slate-400">
    If you're a Pagecord super-fan and have deeper pockets, please consider becoming a <%= link_to "Supporter", supporters_path, class: "underline font-medium" %> for $<%= price_tag(:supporter) %>/year!
  </p>
</div>
