<%# locals: (quote:, name:, url:) %>
<figure class="postcard">
  <blockquote>&ldquo;<%= quote %>&rdquo;</blockquote>
  <figcaption>
    <%= render "letters/stamp" %>
    <%= inline_svg_tag "icons/stamp.svg", class: "postcard__postmark", aria_hidden: true %>
    <span class="postcard__name"><%= name %></span>
    <%= link_to safe_join(url.delete_prefix("https://").delete_suffix("/").split(/(?<=\.)/), tag.wbr), url, class: "postcard__site" %>
  </figcaption>
</figure>
