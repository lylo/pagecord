<% import_intro = local_assigns[:import_intro] %>

<div class="md:mt-4 mb-4 md:mb-8 mx-auto max-w-4xl px-4">
  <% if import_intro.present? %>
    <section class="my-10 md:my-14 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-6 md:p-8">
      <h2 class="source-serif font-semibold text-3xl md:text-4xl tracking-tight text-slate-800 dark:text-slate-200">Bring your posts with you</h2>
      <div class="mt-6 md:text-xl text-base leading-relaxed text-slate-800 dark:text-slate-200 flex flex-col gap-y-4">
        <p><%= import_intro %></p>
        <p>
          Start a free blog first and have a proper look around. Keep your old site live as long as you like &ndash; nothing has to move until you're happy with what you see. When you're ready, <%= link_to "email us", "mailto:hello@pagecord.com?subject=Blog%20Import%20Request", class: "home-link" %> and we'll take it from there. Here's <%= link_to "how importing works", "https://help.pagecord.com/importing-an-existing-blog", class: "home-link" %>.
        </p>
      </div>
    </section>
  <% end %>

  <div class="my-8 text-center flex flex-col md:flex-row gap-3 justify-center items-center">
    <%= link_to new_signup_path do %>
      <div class="inline-flex font-medium p-4 rounded-xl shadow-sm btn-primary text-xl">Create your free Pagecord account</div>
    <% end %>
    <%= link_to spotlight_path do %>
      <div class="inline-flex font-medium p-4 rounded-xl border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-slate-200 text-xl">See Spotlight</div>
    <% end %>
  </div>
</div>
