<%# landing-page: standalone marketing / SEO page (app/views/public), not part of a user's blog %>
<%= content_for :title do %>
  The Minimalist Blogging Platform for Everyone - Pagecord
<% end %>

<%= content_for :og_image do %>
  <%= dynamic_og_image_for_landing_page(title: "The Minimalist Blogging Platform for Everyone") %>
<% end %>

<%= content_for :meta_description do %>
  Pagecord is a minimalist blogging platform with everything a personal blog needs and none of the bloat. Publish from the editor, email, or Obsidian. Classic is free forever.
<% end %>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a minimalist blogging platform?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A blogging platform that keeps the focus on writing: fast pages, clean typography, and no bloat, popups, or tracking scripts that weigh the rest of the web down."
      }
    },
    {
      "@type": "Question",
      "name": "Does minimalist mean there are fewer features?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No! Pagecord is packed with features, pretty much everything you could need. See the full feature list at https://pagecord.com/#features"
      }
    },
    {
      "@type": "Question",
      "name": "Is Pagecord free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Pagecord Classic is free forever. This includes a blog, a rich text editor, publishing by email, and themes. Pagecord Premium gives you everything you need for only $<%= localised_price %>/year."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use my own domain name?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, Premium customers can connect their own custom domain. Classic customers get their own subdomain like yourname.pagecord.com."
      }
    },
    {
      "@type": "Question",
      "name": "How does Pagecord compare to Bear Blog, Mataroa, Pika, or Write.as?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Firstly, all these products are great! By choosing any you're supporting the indie web movement, and that's the main thing. Pagecord brings together the best of all of these products: a wonderful rich text editor, publishing by email, keeping your files local and publishing from Obsidian or iA Writer, custom CSS and code, letting readers subscribe by email, and so much more. Pagecord is also open source, so you can host it yourself if you wanted to."
      }
    }
  ]
}
</script>

<div class="md:mt-4 mb-4 md:mb-8 mx-auto max-w-4xl px-4">
  <h1 class="source-serif font-semibold text-center text-4xl md:text-6xl tracking-tight text-slate-800 dark:text-slate-200">
    The minimalist blogging platform for everyone
  </h1>

  <div class="md:text-xl text-base leading-relaxed text-slate-800 dark:text-slate-200 flex flex-col gap-y-4 mt-8 md:mt-12">
    <p>
      Pagecord has everything a personal blog needs, without the bloat.
    </p>
    <p>
      Posts, pages, comments, RSS, private analytics, email newsletters, custom themes and CSS, custom domains, API access, and multiple blogs. All in one gorgeous, minimalist package.
    </p>
    <p>
      The best blog is the one you keep using. That's Pagecord. Classic is free forever. Premium is only $<%= localised_price %>/year.
    </p>
  </div>

  <div class="text-center mt-8 mb-4 md:text-xl">
    <%= link_to new_signup_path do %>
      <div class="mt-2 inline-flex font-medium p-4 rounded-xl shadow-sm btn-primary text-xl">Create your free Pagecord account</div>
    <% end %>
    <p class="mt-4 text-base text-slate-600 dark:text-slate-400">
      or <%= link_to "learn more on the Pagecord home page", root_path, class: "underline decoration-slate-300 underline-offset-2 hover:text-slate-800 dark:hover:text-slate-200" %>
    </p>
  </div>
</div>

<%= render "screenshots" %>

<div class="md:mt-4 mb-4 md:mb-8 mx-auto max-w-4xl px-4">
  <section class="my-10 md:my-14">
    <h2 class="source-serif font-semibold text-3xl md:text-4xl tracking-tight text-slate-800 dark:text-slate-200">Minimalist blogging FAQ</h2>
    <div class="mt-6 text-base md:text-lg leading-relaxed text-slate-800 dark:text-slate-200 flex flex-col gap-y-4">
      <h3 class="source-serif font-semibold text-2xl mt-2">What is a minimalist blogging platform?</h3>
      <p>
        A blogging platform that keeps the focus on writing: fast pages, clean typography, and no bloat, popups, or tracking scripts that weigh the rest of the web down.
      </p>

      <h3 class="source-serif font-semibold text-2xl mt-2">Does minimalist mean there are fewer features?</h3>
      <p>
        No! Pagecord is packed with features, pretty much everything you could need. See the <a href="https://pagecord.com/#features" class="home-link">feature page</a> for a full list.
      </p>

      <h3 class="source-serif font-semibold text-2xl mt-2">Is Pagecord free?</h3>
      <p>
        Yes! Pagecord Classic is free forever. This includes a blog, a rich text editor, publishing by email, themes. Pagecord Premium gives you everything you need for only $<%= localised_price %>/year.</p>

      <h3 class="source-serif font-semibold text-2xl mt-2">Can I use my own domain name?</h3>
      <p>
        Yes, Premium customers can connect their own custom domain. For classic customers, you get your own subdomain like <span class="font-mono">yourname.pagecord.com</span>.
      </p>

      <h3 class="source-serif font-semibold text-2xl mt-2">How does Pagecord compare to Bear Blog, Mataroa, Pika, or Write.as?</h3>
      <p>
        Firstly, all these products are great! By choosing any you're supporting the indie web movement, and that's the main thing.
      </p>
      <p>
        Pagecord brings together the best of all of these products! It has a wonderful rich text editor, it allows you to publish by email, you can keep your files local and publish from Obsidian or iA Writer, make it your own with Custom CSS and code, allow readers to subscribe by email... and so much more! The <a href="https://pagecord.com/#features" class="home-link">feature list is very long</a>!
      </p>
      <p>
        Pagecord is also <a href="https://github.com/pagecord/pagecord" class="home-link">open source</a>, so you can host it yourself if you wanted to.
      </p>
    </div>
  </section>
</div>

<%= render "landing_testimonials",
  testimonials: [
    { name: "e6on", url: "https://e6on.pagecord.com", quote: "It's simple, it's niche, it's elegant. The most important thing is the words and it takes away all the excuses." },
    { name: "Greg", url: "https://iamgregb.io/", quote: "Pagecord is the perfect place to host your own blog, especially if you want to keep things simple." },
    { name: "Richard Dallaway", url: "https://richard.dallaway.com", quote: "Pagecord has two big attractions. One is rediscovering blogging by email, but a bigger win is the source availability. It does what I need, very nicely." },
    { name: "Kristen", url: "https://thehundredfold.pagecord.com/", quote: "I've used every platform one can imagine over the years! Pagecord is seamless, well designed, and is as simple as an email." },
    { name: "David", url: "https://front.pagecord.com/", quote: "Of all the platforms I've explored, Pagecord is my favourite. The developer is very responsive to suggestions and active in improving the platform while maintaining the core simplicity of using it." },
    { name: "Eetu", url: "https://moonwriting.blog", quote: "Pagecord has everything I'm looking for. Open source, privacy-respecting, with many customization options. Pricing is competitive." }
  ] %>

<%= render "landing_cta" %>
