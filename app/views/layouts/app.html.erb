<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <title>Pagecord :: Admin</title>

    <%= render "layouts/default_favicons" %>
    <%= render "layouts/manifest" %>

    <%= stylesheet_link_tag "tagify-base", "application", "tailwind", "inter", "tagify", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "blog-themes", "lexxy", "lexxy-variables", "lexxy-typography", "lexxy-editor-overrides", "lexxy-variable-overrides" %>
    <%= javascript_importmap_tags %>

    <script src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
    <script type="text/javascript">
      document.addEventListener('turbo:load', function() {
        Paddle.Environment.set('<%= paddle_environment %>')
        Paddle.Initialize(<%= paddle_initialize_data %>)
      })
    </script>
    <%= yield :head %>
  </head>

  <body class="flex flex-col min-h-screen bg-slate-100 dark:bg-slate-950 writing-mode:bg-white dark:writing-mode:bg-slate-900">
    <header class="mb-4 md:mb-6 writing-mode:hidden">
      <% if Current.user.onboarding_complete? && !Current.user.subscribed? %>
        <%= render "/app/shared/premium_upsell_banner" %>
      <% end %>
      <div class="w-full px-4 py-3 relative flex items-center justify-between text-slate-950 dark:text-slate-50">
        <div class="relative md:static" data-controller="toggle">
          <button type="button" class="flex items-center gap-1.5 cursor-pointer rounded-full py-1 px-2.5 bg-white dark:bg-slate-900 shadow-[0_1px_2px_rgba(0,0,0,0.06)] transition-colors hover:bg-slate-50 dark:hover:bg-slate-800 md:hidden" title="Sections" aria-label="Sections" data-toggle-target="button" data-action="toggle#toggle click@window->toggle#hide keydown.esc@window->toggle#hide">
            <%= inline_svg_tag "logo-mark.svg", class: "h-7 w-7" %>
            <%= inline_svg_tag "icons/chevron-down.svg", class: "h-3.5 w-3.5 text-slate-400" %>
          </button>
          <%= link_to app_root_path, class: "hidden md:inline-flex transition-transform hover:-rotate-12", title: "Pagecord" do %>
            <%= inline_svg_tag "logo-mark.svg", class: "h-7 w-7" %>
          <% end %>
          <%= render "app/shared/nav" %>
        </div>
        <%= render "app/shared/heading" %>
      </div>
    </header>
    <main class="container mx-auto px-4 flex flex-grow">
      <div class="mx-auto flex w-full max-w-3xl flex-col text-slate-950 dark:text-slate-50">
        <div id="flash"><%= render "app/shared/flash" %></div>

        <% if content_for?(:sheets) %>
          <%= yield %>
        <% else %>
          <div class="sheet flex flex-grow flex-col writing-mode:rounded-none writing-mode:shadow-none writing-mode:pt-[12vh]">
            <%= yield %>
          </div>
        <% end %>
      </div>
    </main>

    <footer class="writing-mode:hidden mx-auto w-full max-w-3xl px-4 py-10 text-center text-sm text-slate-500 dark:text-slate-400">
      <div class="flex items-center justify-center gap-x-5">
        <%= link_to "Help", "https://help.pagecord.com", class: "hover:text-slate-800 dark:hover:text-slate-200" %>
        <%= link_to "FAQ", faq_path, class: "hover:text-slate-800 dark:hover:text-slate-200" %>

        <%= link_to "https://github.com/lylo/pagecord", "aria-label": "Pagecord on GitHub" do %>
          <%= inline_svg_tag "icons/social/github.svg", class: "h-4 w-4 hover:text-slate-800 dark:hover:text-slate-200", title: "Pagecord on GitHub" %>
        <% end %>
      </div>

      <%= link_to app_root_path, "aria-label": "Pagecord home" do %>
        <%= inline_svg_tag "logo.svg", class: "mt-6 w-[100px] inline-flex text-slate-900 dark:text-slate-100" %>
      <% end %>
    </footer>
  </body>
</html>
