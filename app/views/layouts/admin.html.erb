<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Pagecord :: Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= render "layouts/default_favicons" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter", "blog-themes", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body class="flex flex-col min-h-screen bg-slate-100 dark:bg-slate-950">
    <%= render "admin/shared/header" %>

    <main class="container mx-auto px-4 flex flex-grow mb-10">
      <div class="mx-auto flex w-full max-w-5xl flex-col text-slate-950 dark:text-slate-50">
        <div id="flash"><%= render "app/shared/flash" %></div>

        <% if content_for?(:sheets) %>
          <%= yield %>
        <% else %>
          <div class="sheet flex flex-grow flex-col">
            <%= yield %>
          </div>
        <% end %>
      </div>
    </main>
  </body>
</html>
