<!DOCTYPE html>
<%# scroll-pt clears the sticky header, which is two rows tall below md. %>
<html lang="en" class="scroll-pt-36 md:scroll-pt-24">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csp_meta_tag %>
    <title><%= content_for?(:title) ? content_for(:title) : "Pagecord: Make yourself a home on the web" %></title>
    <%= render "layouts/default_favicons" %>
    <%= render "layouts/manifest" %>

    <%= render "layouts/open_graph" %>

    <link rel="canonical" href="<%= canonical_url %>">
    <%= yield :head %>

    <%= preload_fonts([
      "inter/InterVariable.woff2",
      "source-serif-4/SourceSerif4Variable-Roman.ttf.woff2"
    ]) %>
    <style>
      @font-face {
        font-family: "InterVariable";
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url("<%= asset_path("inter/InterVariable.woff2") %>") format("woff2-variations");
      }

      @font-face {
        font-family: "SourceSerif4Variable";
        font-style: normal;
        font-weight: 200 900;
        font-display: swap;
        src: url("<%= asset_path("source-serif-4/SourceSerif4Variable-Roman.ttf.woff2") %>") format("woff2-variations");
      }

      body {
        font-family: "InterVariable", ui-sans-serif, system-ui, sans-serif;
      }

      .source-serif {
        font-family: "SourceSerif4Variable", Georgia, serif;
      }
    </style>
    <%= stylesheet_link_tag "tailwind", "caveat", "letter", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags "home", importmap: Rails.application.config.importmap_home %>
    <script>
      window.addEventListener("load", function() {
        var script = document.createElement("script")
        script.src = "https://cdn.paddle.com/paddle/v2/paddle.js"
        script.onload = function() {
          <% if Rails.env.development? %>
            Paddle.Environment.set("sandbox")
            Paddle.Initialize({
              token: "test_945b246ef8df8bfe446632bf70b"
            })
          <% else %>
            Paddle.Environment.set("production")
            Paddle.Initialize({
              token: "live_8d79ebbaac5c745a173f00967fb"
            })
          <% end %>
        }
        document.head.appendChild(script)
      })
    </script>
    <script defer data-domain="pagecord.com" src="https://plausible.io/js/script.js"></script>
  </head>

  <body id="top" class="home flex flex-col min-h-screen bg-white dark:bg-slate-950">
    <%= render "layouts/header" %>

    <main class="flex flex-grow text-slate-950 dark:text-slate-50">
      <div class="mx-auto mt-8 w-full">
        <%= yield %>
      </div>
    </main>

    <%= render "layouts/footer" %>
   </body>
</html>
