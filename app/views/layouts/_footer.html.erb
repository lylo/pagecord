<footer class="w-full mt-8 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-sm text-slate-500 dark:text-slate-400">
  <div class="mx-auto max-w-6xl px-6 pt-14 pb-10 flex flex-col md:flex-row md:justify-between gap-12">
    <div class="flex flex-col gap-6">
      <div class="relative w-fit">
        <%= link_to root_path, "aria-label": "Pagecord Home" do %>
          <%= inline_svg_tag "logo.svg", class: "w-[140px] text-slate-900 dark:text-slate-100" %>
        <% end %>
        <%= inline_svg_tag "icons/stamp.svg", class: "absolute -top-5 left-24 w-40 -rotate-8 text-slate-400/60 dark:text-slate-500/60 pointer-events-none", aria_hidden: true %>
      </div>

      <address class="not-italic">
        <span class="block text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500">Return address</span>
        <span class="block mt-1 font-[CaveatVariable] text-2xl leading-snug text-slate-700 dark:text-slate-300">
          Pagecord Ltd, 3F1 Third Floor,<br>3 Hill Street, Edinburgh, EH2 3JP
        </span>
      </address>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-[repeat(3,auto)] gap-x-16 gap-y-10">
      <% [
        [ "Pagecord", [ [ "Features", features_path ], [ "Principles", principles_path ], [ "Supporters", supporters_path ], [ "Minimalist blogging", minimalist_blogging_path ], [ "Indie blogging", indie_blogging_platform_path ] ] ],
        [ "Help", [ [ "Help guide", "https://help.pagecord.com" ], [ "FAQ", faq_path ], [ "Log In", login_path ] ] ],
        [ "Legal", [ [ "Terms", terms_path ], [ "Privacy", privacy_path ], [ "AI", ai_path ] ] ]
      ].each do |heading, links| %>
        <nav aria-label="<%= heading %>" class="flex flex-col gap-2.5">
          <h2 class="mb-1 source-serif text-lg font-semibold text-slate-900 dark:text-slate-100"><%= heading %></h2>
          <% links.each do |label, path| %>
            <%= link_to label, path, class: "w-fit text-slate-600 dark:text-slate-400 decoration-pagecord-accent decoration-2 underline-offset-4 hover:underline hover:text-slate-900 dark:hover:text-slate-100" %>
          <% end %>
        </nav>
      <% end %>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6 py-5 flex items-center justify-between gap-4 border-t border-slate-200 dark:border-slate-800 text-xs text-slate-400 dark:text-slate-500">
    <p>Pagecord Ltd (SC875271) &middot; Independent and open source</p>
    <%= link_to "https://github.com/lylo/pagecord", "aria-label": "Pagecord on GitHub", class: "hover:text-slate-900 dark:hover:text-slate-100" do %>
      <%= inline_svg_tag "icons/social/github.svg", class: "w-5 h-5" %>
    <% end %>
  </div>
</footer>
