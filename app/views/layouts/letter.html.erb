<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= content_for?(:title) ? content_for(:title) : "Pagecord" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:meta_description) ? content_for(:meta_description) : "Pagecord is the perfect home for your writing on the web. Publish from the editor, email, Obsidian or iA Writer, with pages, a newsletter, comments, analytics and a domain of your own." %>">
    <%= render "layouts/default_favicons" %>
    <%= render "layouts/manifest" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "application", "inter", "source-serif-4", "ibm-plex-mono", "caveat", "letter", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script defer data-domain="pagecord.com" src="https://plausible.io/js/script.js"></script>
  </head>

  <body class="letter-page">
    <main class="letter-desk">
      <%= render "app/shared/flash" %>
      <%= yield %>

      <p class="letter-footer">
        <% if controller_path.start_with?("signups") %>
          Already writing on Pagecord? <%= link_to "Sign in", login_path %>
        <% else %>
          New here? <%= link_to "Start a blog", new_signup_path %>
        <% end %>
        · <%= link_to "pagecord.com", root_path %>
      </p>
    </main>
  </body>
</html>
