<% content_for :title, "Pagecord - Sign in" %>
<% content_for :meta_description, "Sign in to your Pagecord account to post and manage your blog" %>

<%= form_with url: sessions_path, model: @user, class: "letter-form", data: { turbo: false, controller: "signature" } do |form| %>
  <div class="letter-paper">
    <%= render "letters/letterhead" %>

    <p>Dear Pagecord,</p>
    <p>
      It's me again, from
      <span class="letter-field">
        <%= form.label :subdomain, "Subdomain", class: "sr-only" %>
        <%= form.text_field :subdomain,
            value: @user.blogs.first&.subdomain,
            placeholder: "subdomain",
            maxlength: Subdomain::MAX_LENGTH,
            required: true,
            autofocus: true,
            autocapitalize: "none",
            spellcheck: false,
            class: "letter-blank letter-blank--subdomain",
            data: { signature_target: "source", action: "input->signature#sign" } %><span>.pagecord.com.</span>
      </span>
    </p>
    <p>
      <% if @password_mode %>
        My password is
        <span class="letter-field">
          <%= form.label :password, "Password", class: "sr-only" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", class: "letter-blank letter-blank--password" %><span class="letter-trail">.</span>
        </span>
      <% else %>
        Please send a sign-in link to
        <span class="letter-field">
          <%= form.label :email, "Email", class: "sr-only" %>
          <%= form.email_field :email, placeholder: "your email", required: true, autocomplete: "email", class: "letter-blank letter-blank--email" %><span class="letter-trail">.</span>
        </span>
      <% end %>
    </p>

    <p class="letter-note" role="alert"><% if @password_rejected %>That blog address and password don't match. Try again, or <%= link_to "sign in with a link", login_path %>?<% end %></p>

    <p>Yours,</p>
    <p class="letter-signature" data-signature-target="output"><%= @user.blogs.first&.subdomain %></p>

    <div class="letter-send">
      <%= form.button type: "submit", class: "btn-primary" do %>
        <%= @password_mode ? "Sign in" : "Send me a link" %>
        <%= inline_svg_tag "icons/paper-airplane.svg", class: "w-5 h-5" %>
      <% end %>
      <% if @password_mode %>
        <span class="letter-aside"><%= link_to "Email me a link instead", login_path %><%= link_to "Forgotten your password?", new_password_reset_path %></span>
      <% else %>
        <span class="letter-aside"><%= link_to "Use my password instead", login_path(mode: :password) %></span>
      <% end %>
    </div>
  </div>
<% end %>
