<%= turbo_frame_tag :posts, target: "_top" do %>
  <div class="posts-titles h-feed">
    <% previous_year = params[:last_visible_year]&.to_i %>
    <% @posts.each do |post| %>
      <% post_date = post.is_page? ? post.updated_at : post.published_at %>
      <% if post_date.year != previous_year %>
        <h2 class="year-header <%= 'has-previous' if previous_year %>">
          <%# Rendered server-side, not with local_time: the heading must match the %>
          <%# year the group was keyed on, or the reader's timezone can relabel it. %>
          <%= post_date.year %>
        </h2>
        <% previous_year = post_date.year %>
      <% end %>
      <div class="<%= token_list("post-row", "h-entry", "link-post": post.link_url?) %>" <%= tag.attributes(data: post_tag_data(post)) %>>
        <%= local_time post_date, format: @blog.month_day_format, class: "dt-published" %>
        <%= render "blogs/posts/title_link", post: post %>
      </div>
    <% end %>
  </div>

  <% if @pagy.next %>
    <%= turbo_frame_tag :posts, target: "_top", src: url_for(page: @pagy.next, last_visible_year: previous_year, tag: params[:tag], q: params[:q], host: request.host), loading: :lazy %>
  <% end %>
<% end %>

