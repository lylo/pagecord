<%= turbo_frame_tag :posts, target: "_top" do %>
  <div class="h-feed" data-controller="media-embeds">
    <%= render partial: "card_post", collection: @posts, as: :post %>
  </div>

  <% if @pagy.next %>
    <%= turbo_frame_tag :posts, target: "_top", src: url_for(page: @pagy.next, tag: params[:tag], host: request.host), loading: :lazy %>
  <% end %>
<% end %>
