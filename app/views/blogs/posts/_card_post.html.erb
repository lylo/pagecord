<% cache [post, @blog.updated_at] do %>
  <div class="post-card h-entry" <%= tag.attributes(data: post_tag_data(post)) %>>
    <%= link_to post_path(post), class: "post-card-link u-url" do %>
      <div class="post-card-content">
        <% if (image = post_thumbnail(post)) %>
          <div class="post-card-image">
            <%= image_tag resized_image_url(image, width: 1600, height: 1200), alt: post.display_title %>
          </div>
        <% elsif !post.has_text_content? && (media = post.first_media)&.video? %>
          <div class="post-card-image">
            <% if media.preview_image.attached? %>
              <%= image_tag resized_image_url(media.preview_image.blob, width: 1600, height: 1200), alt: post.display_title %>
            <% else %>
              <%= video_tag rails_public_blob_url(media), preload: "metadata", muted: true, playsinline: true, class: "post-card-video" %>
            <% end %>
          </div>
        <% end %>

        <% if post.title.present? %>
          <h2 class="post-card-title p-name">
            <%= post.title %>
          </h2>
        <% end %>

        <% if (excerpt = post.card_excerpt_html).present? %>
          <div class="post-card-summary p-summary">
            <%= excerpt %>
          </div>
        <% end %>

        <div class="post-card-meta <%= post.tag_list.present? ? 'has-tags' : 'no-tags' %>">
          <%= local_time post.published_at, format: published_at_date_format, class: "post-card-date dt-published" %>
          <span class="post-card-badge">
            <%= t('posts.read_more') %>
          </span>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
