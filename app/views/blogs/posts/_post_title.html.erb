<%# locals: (post:, url: nil) %>
<% if post.title.present? %>
  <h1 class="post-title p-name">
    <% if post.link_url? %>
      <%= link_to post.title, post.link_url, class: "post-title-link u-bookmark-of", **new_tab_link_options %>
    <% else %>
      <%= link_to post.title, url || post_url(post), class: "post-title-link u-url" %>
    <% end %>
  </h1>
<% end %>
