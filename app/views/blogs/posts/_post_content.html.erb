<div class="post-body lexxy-content e-content" data-controller="syntax-highlight">
  <% if local_assigns[:excerpt] && post.has_excerpt? %>
    <%= render_post_excerpt(post) %>
    <p class="excerpt-read-more">
      <%= link_to t('posts.read_more'), post_path(post) %>
    </p>
  <% else %>
    <%= render_post_content(post) %>
  <% end %>
</div>
