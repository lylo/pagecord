<%= content_for :robots_meta do %>
  <meta name="robots" content="noindex, nofollow">
<% end %>

<%= render "blogs/header", hide_email_form: true, hide_bio: !@post.home_page? %>

<% preview_url = blog_post_preview_url(params[:id], host: @blog.host) %>

<div data-controller="media-embeds lightbox">
  <article class="<%= @post.page? ? 'page' : 'post' %> h-entry">
    <%= render "blogs/posts/post_title", post: @post, url: preview_url %>
    <%= render "blogs/posts/post_content", post: @post %>

    <% if @post.post? %>
      <%= render "blogs/posts/tags", post: @post if @post.tag_list.present? %>

      <footer>
        <%= link_to preview_url, class: "post-date u-url" do %>
          <%= local_time @post.display_date, format: published_at_date_format, class: "dt-published" %>
        <% end %>
      </footer>
    <% end %>
  </article>
</div>
