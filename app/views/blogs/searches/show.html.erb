<%= render "blogs/header", hide_email_form: true, hide_bio: true %>

<%= render "blogs/searches/form", query: @query, autofocus: true %>

<% if @query.present? %>
  <% if @posts.empty? %>
    <div class="empty-state">
      <p><%= t("search.no_results") %></p>
    </div>
  <% else %>
    <div class="tag-filter-notice">
      <p><%= t("search.results_count_html", count: @pagy.count, query: @query) %></p>
    </div>

    <div class="title_layout">
      <%= render "blogs/posts/title_layout" %>
    </div>
  <% end %>
<% end %>
