<% posts.group_by { |post| post.published_at.year }.each_with_index do |(year, year_posts), index| %>
  <%= render "blogs/custom_tags/posts_by_year_group", year: year, posts: year_posts, frame_id: frame_id, has_previous: index.positive? %>
<% end %>
<% if has_next %>
  <%= turbo_frame_tag "embedded-posts-#{frame_id}-page-2",
      src: blog_embedded_posts_path(page: 2, style: "by_year", frame_id: frame_id,
            page_frame_id: "embedded-posts-#{frame_id}-page-2",
            last_visible_year: posts.last.published_at.year, **filter_params),
      loading: :lazy %>
<% end %>
