<% quota = Current.user.upload_quota %>
<div data-controller="settings-panel autosave"
    data-autosave-key-value="<%= home_page.persisted? ? "draft-homepage-#{home_page.id}" : "draft-homepage-new-#{@blog.id}" %>"
    data-autosave-base-title-value="<%= home_page.title.to_s %>"
    data-autosave-base-content-value="<%= h(home_page.content&.body&.to_html.to_s) if home_page.persisted? %>">


  <%= form_with(model: home_page, url: home_page.persisted? ? app_home_page_path : app_home_page_path, method: home_page.persisted? ? :patch : :post, html: { id: "homepage-form" }) do |form| %>
    <%= hidden_field_tag :context_blog_id, @blog.id unless home_page.persisted? %>

    <%= render "settings_panel", form: form %>

    <div class="sheet-header mb-6 flex-wrap justify-between gap-x-3 gap-y-2">
      <div class="hidden sm:flex items-center gap-x-2 min-w-0">
        <%= render "app/shared/help/edit_page" %>
      </div>
      <div class="flex flex-wrap items-center justify-end gap-2 ms-auto">
        <%= render "app/posts/settings_button", record: home_page, label: "Home page settings" %>
        <%= link_to (home_page.persisted? ? "Cancel" : "Discard"), app_pages_path,
              class: "btn-optional",
              data: { action: "click->autosave#cancel" } %>
        <%= form.button draft_button_text(home_page, model_name: "Home Page"), name: "post[status]", value: "draft", class: "btn-optional" %>
        <%= render "app/posts/publish_button", form: form, record: home_page, model_name: "Home Page" %>
      </div>
    </div>

    <%= render "app/posts/title_field", form: form %>

    <fieldset>
      <div class="field-error"><%= home_page.errors.full_messages_for(:content).first %></div>
      <%= form.rich_text_area :content,
          placeholder: "Write your home page content...",
          class: "lexxy-content lexxy-borderless mt-4",
          spellcheck: true,
          autocorrect: "on",
          autocapitalize: "sentences",
          data: { controller: "lexxy ios-toolbar", autosave_target: "content", attachments: !quota.exceeded?, videos: quota.unlimited? } %>

    </fieldset>

    <%= render "app/shared/upload_quota", quota: quota %>
  <% end %>
</div>
