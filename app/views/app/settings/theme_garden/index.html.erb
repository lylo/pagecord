<%= render "app/settings/header", title: "Theme Garden", heading: "Pick a ready-made design", description: "Browse our curated selection of theme templates and apply them to your blog with one click.", parent: "Appearance", parent_path: app_settings_appearance_path %>

<div>
  <%= settings_section do %>
    <div class="py-5">
      <% if @templates.any? %>
        <%= render "templates", templates: @templates %>
      <% else %>
        <p class="text-slate-500 dark:text-slate-400">No templates available yet. Check back soon!</p>
      <% end %>
    </div>
  <% end %>
</div>
