<div class="rounded-lg overflow-hidden bg-slate-50 dark:bg-slate-800 hover:shadow-md transition-shadow <%= "ring-2 ring-pagecord-accent" if current %>">
  <% if screenshot %>
    <%= image_tag screenshot, class: "w-full h-48 object-cover object-top", alt: name %>
  <% else %>
    <div class="w-full h-48 bg-slate-100 dark:bg-slate-700 flex items-center justify-center">
      <span class="text-slate-400 dark:text-slate-500 text-sm">No preview</span>
    </div>
  <% end %>

  <div class="p-4">
    <h4 class="font-bold text-lg mb-1"><%= name %></h4>
    <% if local_assigns[:author_name].present? %>
      <p class="text-xs text-slate-400 dark:text-slate-500 mb-3">
        By
        <% if author_url.present? %>
          <%= link_to author_name, author_url, class: "underline", target: "_blank" %>
        <% else %>
          <%= author_name %>
        <% end %>
      </p>
    <% end %>

    <div class="flex gap-2">
      <% if local_assigns[:preview_path].present? %>
        <%= link_to "Preview", preview_path, class: "btn-secondary text-sm", target: "_blank" %>
      <% end %>
      <%= button_to "Apply", apply_path, class: "btn-primary text-sm", form_class: "contents", form: { data: { turbo_confirm: local_assigns[:confirm] } } %>
    </div>
  </div>
</div>
