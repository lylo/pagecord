<div class="mt-6 flex flex-col gap-2 sm:flex-row sm:gap-4">
  <label class="option-card items-center gap-2">
    <%= form.radio_button :font, "sans", checked: @blog.font == "sans", class: "option-radio", id: "font_sans" %>
    <span class="font-sans">Sans-serif</span>
  </label>

  <label class="option-card items-center gap-2">
    <%= form.radio_button :font, "serif", checked: @blog.font == "serif", class: "option-radio", id: "font_serif" %>
    <span class="font-serif">Serif</span>
  </label>

  <label class="option-card items-center gap-2">
    <%= form.radio_button :font, "mono", checked: @blog.font == "mono", class: "option-radio", id: "font_mono" %>
    <span class="font-mono">Monospace</span>
  </label>
</div>
