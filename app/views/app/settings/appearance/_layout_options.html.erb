<div class="mt-6 flex flex-col gap-2 sm:flex-row sm:gap-4">
  <label class="option-card items-center gap-2">
    <%= form.radio_button :layout, "stream_layout", checked: @blog.stream_layout?, class: "option-radio", id: "layout_stream" %>
    <span>Stream</span>
  </label>

  <label class="option-card items-center gap-2">
    <%= form.radio_button :layout, "title_layout", checked: @blog.title_layout?, class: "option-radio", id: "layout_titles" %>
    <span>List of Titles</span>
  </label>

  <label class="option-card items-center gap-2">
    <%= form.radio_button :layout, "cards_layout", checked: @blog.cards_layout?, class: "option-radio", id: "layout_cards" %>
    <span>Cards</span>
  </label>
</div>
