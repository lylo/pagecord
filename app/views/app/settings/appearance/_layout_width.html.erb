<div class="mt-6 grid grid-cols-1 gap-2 sm:grid-cols-3 sm:gap-4">
  <% [ [ "narrow", "Narrow", "w-1/3" ], [ "standard", "Standard", "w-1/2" ], [ "wide", "Wide", "w-5/6" ] ].each do |value, label, bar| %>
    <label class="option-card flex-col">
      <%= form.radio_button :width, value, checked: @blog.width == value, class: "sr-only", id: "width_#{value}" %>

      <div class="mb-3 flex w-full justify-center">
        <div class="<%= bar %> h-12 rounded bg-slate-200 dark:bg-slate-700"></div>
      </div>

      <div class="text-center"><%= label %></div>
    </label>
  <% end %>
</div>
