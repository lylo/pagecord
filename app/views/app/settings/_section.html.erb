<% breadcrumb = settings_breadcrumb %>

<section class="sheet [&:not(:first-of-type)]:mt-6">
  <%= breadcrumb %>

  <% if title || description || control %>
    <div class="sheet-band flex items-start justify-between gap-4 py-5 <%= "-mt-(--sheet-padding) rounded-t-lg" unless breadcrumb %>">
      <div>
        <% if title %>
          <h3 class="text-xl font-bold text-slate-900 dark:text-slate-100"><%= title %></h3>
        <% end %>
        <% if description %>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= description %></p>
        <% end %>
      </div>
      <%= control if control %>
    </div>
  <% end %>

  <div class="divide-y divide-slate-200 dark:divide-slate-800">
    <%= yield %>
  </div>
</section>
