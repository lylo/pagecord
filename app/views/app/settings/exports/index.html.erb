<%= render "app/settings/header", title: "Exports", heading: "Export your posts", description: "Download a ZIP archive of your posts. Videos are not currently included in exports." %>

<div>
  <%= settings_section do %>
    <%= settings_row "Format", stacked: true do %>
      <%= form_with model: Blog::Export.new, url: app_settings_exports_path, local: true, class: "space-y-4" do |form| %>
        <fieldset>
          <div class="flex flex-col sm:flex-row gap-y-2 sm:gap-x-4">
            <label class="option-card items-center gap-2">
              <%= form.radio_button :format, "html", checked: true, class: "option-radio", id: "format_html" %>
              <span>HTML</span>
            </label>

            <label class="option-card items-center gap-2">
              <%= form.radio_button :format, "markdown", class: "option-radio", id: "format_markdown" %>
              <span>Markdown</span>
            </label>
          </div>
        </fieldset>

        <%= form.submit "Generate Export", class: "btn-primary" %>
      <% end %>
    <% end %>

  <% end %>

  <%= settings_section "Your Exports", description: "Exports are automatically deleted after 7 days." do %>
    <% if @exports.empty? %>
      <p class="py-8 text-center text-slate-600 dark:text-slate-300">You have no exports yet.</p>
    <% else %>
      <%= render "exports" %>
    <% end %>
  <% end %>
</div>
