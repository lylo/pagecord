<div class="divide-y divide-slate-200 dark:divide-slate-800">
  <% @exports.each do |export| %>
    <div class="flex items-center justify-between gap-3 py-4">
      <div class="min-w-0">
        <div class="font-medium text-slate-900 dark:text-slate-100">
          <%= export.display_format %>
        </div>
        <div class="text-sm text-slate-500 dark:text-slate-400">
          <%= export.created_at.to_formatted_s(:short) %> · <%= export.status.titleize %>
        </div>
      </div>

      <div class="flex shrink-0 items-center gap-2">
        <% if export.file.present? %>
          <%= link_to rails_blob_path(export.file, disposition: "attachment"), class: "btn-primary" do %>
            <%= inline_svg_tag "icons/download.svg", class: "w-4 h-4" %>
            <span class="hidden sm:inline ms-2">Download</span>
          <% end %>
        <% end %>

        <%= button_to app_settings_export_path(export), method: :delete, class: "btn-danger", form_class: "contents", data: { turbo_confirm: "Delete this export? This cannot be undone." } do %>
          <%= inline_svg_tag "icons/trash.svg", class: "w-4 h-4" %>
          <span class="hidden sm:inline ms-2">Delete</span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
