<% turbo_refreshes_with scroll: :preserve if @navigation_item&.errors&.any? %>
<% editing = @navigation_item&.persisted? %>

<% nav_help = capture do %>
  <%= render "app/shared/dialog",
    id: "navigation-help",
    title: "Navigation Quick Start",
    button_label: "Navigation help",
    shortcut: "?",
    content_partial: "app/shared/help/navigation_content" %>
<% end %>

<%= render "app/settings/header", title: "Navigation", heading: "Set up your navigation",
      description: "Links in your blog's header. Drag to reorder.", control: nav_help %>

<div>
  <%= settings_section do %>
    <% if @navigation_items.any? %>
      <div data-controller="sortable"
           data-sortable-resource-name-value="navigation_item"
           data-sortable-handle-value=".handle"
           data-sortable-animation-value="150">
        <%= render partial: "navigation_item", collection: @navigation_items %>
      </div>
    <% else %>
      <p class="py-8 text-center text-slate-600 dark:text-slate-300">
        No navigation links yet. Add one below.
      </p>
    <% end %>
  <% end %>

  <%= settings_section editing ? "Edit link" : "Add a link" do %>
    <div id="navigation-form" class="py-5" data-controller="navigation-form" data-navigation-form-rss-feed-url-value="<%= rss_feed_url(@blog) %>">
      <%= form_with model: [:app, :settings, @navigation_item || NavigationItem.new], scope: :navigation_item, url: editing ? app_settings_navigation_item_path(@navigation_item) : app_settings_navigation_items_path, class: "space-y-6" do |form| %>
        <div class="<%= "hidden" if editing %>">
          <div class="space-y-3">
            <% selected_type = if @navigation_item.nil? || @navigation_item.is_a?(PageNavigationItem)
                 "page"
               elsif @navigation_item.is_a?(PostsNavigationItem)
                 "posts"
               elsif @navigation_item.is_a?(SocialNavigationItem)
                 "social"
               elsif @navigation_item.is_a?(SearchNavigationItem)
                 "search"
               else
                 "custom"
               end %>
            <label class="flex items-center">
              <%= radio_button_tag :nav_type, "page", selected_type == "page",
                  class: "rounded-full border-slate-300 dark:border-slate-600 text-pagecord-accent focus:ring-pagecord-accent",
                  data: { navigation_form_target: "pageRadio", action: "change->navigation-form#toggleFields" } %>
              <span class="ml-2">Link to a page</span>
            </label>
            <% if @navigation_item.is_a?(PostsNavigationItem) || !@blog.navigation_items.exists?(type: "PostsNavigationItem") %>
              <label class="flex items-center">
                <%= radio_button_tag :nav_type, "posts", selected_type == "posts",
                    class: "rounded-full border-slate-300 dark:border-slate-600 text-pagecord-accent focus:ring-pagecord-accent",
                    data: { navigation_form_target: "postsRadio", action: "change->navigation-form#toggleFields" } %>
                <span class="ml-2">Your posts</span>
              </label>
            <% end %>
            <label class="flex items-center">
              <%= radio_button_tag :nav_type, "custom", selected_type == "custom",
                  class: "rounded-full border-slate-300 dark:border-slate-600 text-pagecord-accent focus:ring-pagecord-accent",
                  data: { navigation_form_target: "customRadio", action: "change->navigation-form#toggleFields" } %>
              <span class="ml-2">Custom link</span>
            </label>
            <label class="flex items-center">
              <%= radio_button_tag :nav_type, "social", selected_type == "social",
                  class: "rounded-full border-slate-300 dark:border-slate-600 text-pagecord-accent focus:ring-pagecord-accent",
                  data: { navigation_form_target: "socialRadio", action: "change->navigation-form#toggleFields" } %>
              <span class="ml-2">Social link</span>
            </label>
            <% if @navigation_item.is_a?(SearchNavigationItem) || !@blog.navigation_items.exists?(type: "SearchNavigationItem") %>
              <label class="flex items-center">
                <%= radio_button_tag :nav_type, "search", selected_type == "search",
                    class: "rounded-full border-slate-300 dark:border-slate-600 text-pagecord-accent focus:ring-pagecord-accent",
                    data: { navigation_form_target: "searchRadio", action: "change->navigation-form#toggleFields" } %>
                <span class="ml-2">Search</span>
              </label>
            <% end %>
          </div>
        </div>

        <div data-navigation-form-target="pageFields" class="<%= 'hidden' if selected_type != 'page' %>">
          <%= form.label :post_id, "Page", class: "block font-medium mb-2" %>
          <%= form.select :post_id,
              options_from_collection_for_select(@pages, :id, :title, @navigation_item&.post_id),
              { include_blank: "Select a page..." },
              class: "w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200" %>
        </div>

        <div data-navigation-form-target="postsFields" class="<%= 'hidden' if selected_type != 'posts' %>">
          <%= form.label :label, "Label", class: "block font-medium mb-2", for: "navigation_item_posts_label" %>
          <%= form.text_field :label,
              id: "navigation_item_posts_label",
              value: @navigation_item&.label || "Blog",
              class: "w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200" %>
          <div class="field-error"><%= @navigation_item.errors[:label].to_sentence if @navigation_item&.errors&.[](:label)&.any? %></div>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            Links to all your posts. Rename it to suit your blog.
          </p>
        </div>

        <div data-navigation-form-target="customFields" class="space-y-4 <%= 'hidden' if selected_type != 'custom' %>">
          <fieldset>
            <%= form.label :label, "Label", class: "block font-medium mb-2" %>
            <%= form.text_field :label,
                placeholder: "e.g., Archive, Newsletter, Shop",
                class: "w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200" %>
            <div class="field-error"><%= @navigation_item.errors[:label].to_sentence if @navigation_item&.errors&.[](:label)&.any? %></div>
          </fieldset>

          <fieldset>
            <%= form.label :url, "URL", class: "block font-medium mb-2" %>
            <%= form.text_field :url,
                placeholder: "e.g., /archive, https://example.com",
                class: "w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200" %>
            <div class="field-error"><%= @navigation_item.errors[:url].to_sentence if @navigation_item&.errors&.[](:url)&.any? %></div>
          </fieldset>

          <div class="group pt-2">
            <div class="flex gap-3">
              <div class="flex h-6 shrink-0 items-center">
                <%= styled_check_box form, :use_icon, checked: @navigation_item&.use_icon || @navigation_item&.icon_svg?, id: "use-icon" %>
              </div>
              <div>
                <%= form.label :use_icon, "Show a custom icon", for: "use-icon", class: "text-slate-800 dark:text-slate-100" %>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Add SVG code for a custom logo, shown beside the label or on its own.</p>
              </div>
            </div>

            <div class="mt-4 hidden space-y-4 group-has-[[id=use-icon]:checked]:block">
              <fieldset>
                <%= form.label :icon_svg, "Icon", class: "sr-only" %>
                <%= form.text_area :icon_svg,
                    rows: 3,
                    placeholder: "<svg viewBox=\"0 0 24 24\">…</svg>",
                    class: "autogrow min-h-20 max-h-60 w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 font-mono text-sm" %>
                <div class="field-error"><%= @navigation_item.errors[:icon_svg].to_sentence if @navigation_item&.errors&.[](:icon_svg)&.any? %></div>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                  <%= link_to "Simple Icons", "https://simpleicons.org", class: "underline", target: "_blank", rel: "noopener" %> has brand logos and
                  <%= link_to "Phosphor", "https://phosphoricons.com", class: "underline", target: "_blank", rel: "noopener" %> has everything else.
                  <%= link_to "Help with icons", "https://help.pagecord.com/setting-up-navigation#adding-a-custom-icon", class: "underline", target: "_blank", rel: "noopener" %>
                </p>
              </fieldset>

              <div class="flex flex-col gap-2 sm:flex-row sm:gap-4">
                <label class="option-card items-center gap-2">
                  <%= form.radio_button :show_label, true, class: "option-radio" %>
                  <span>Icon and label</span>
                </label>
                <label class="option-card items-center gap-2">
                  <%= form.radio_button :show_label, false, class: "option-radio" %>
                  <span>Icon only</span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <div data-navigation-form-target="socialFields" class="space-y-4 <%= 'hidden' if selected_type != 'social' %>">
          <fieldset>
            <%= form.label :platform, "Platform", class: "block font-medium mb-2" %>
            <%= form.select :platform,
                options_for_select(SocialNavigationItem::PLATFORMS, @navigation_item&.platform),
                { include_blank: "Select platform..." },
                class: "w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200",
                data: { navigation_form_target: "platform", action: "change->navigation-form#handlePlatformChange" } %>
            <div class="field-error"><%= @navigation_item.errors[:platform].to_sentence if @navigation_item&.errors&.[](:platform)&.any? %></div>
          </fieldset>

          <fieldset>
            <%= form.label :url, "URL", class: "block font-medium mb-2", for: "navigation_item_social_url" %>
            <%= form.text_field :url,
                id: "navigation_item_social_url",
                placeholder: "https://...",
                class: "w-full rounded-lg border-slate-300 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200",
                data: { navigation_form_target: "url" } %>
            <div class="field-error"><%= @navigation_item.errors[:url].to_sentence if @navigation_item&.errors&.[](:url)&.any? %></div>
          </fieldset>
        </div>

        <div data-navigation-form-target="searchFields" class="<%= 'hidden' if selected_type != 'search' %>">
          <p class="text-sm text-slate-500 dark:text-slate-400">
            Adds a search icon to your navigation, linking to your blog's search page.
          </p>
        </div>

        <div class="flex items-center gap-x-2">
          <%= form.submit editing ? "Save" : "Add to Navigation", class: "btn-primary" %>
          <%= link_to "Cancel", app_settings_navigation_items_path, class: "btn-secondary" if editing %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
