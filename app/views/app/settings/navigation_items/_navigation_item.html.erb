<div class="flex items-center gap-3 py-3 border-b border-slate-200 dark:border-slate-800 last:border-b-0"
     data-id="<%= navigation_item.id %>"
     data-sortable-update-url="<%= app_settings_navigation_item_path(navigation_item) %>">
  <div class="handle cursor-grab" title="Drag to reorder">
    <%= inline_svg_tag "icons/grip-dots.svg", class: "w-4 h-4" %>
  </div>
  <% icon = navigation_item_icon(navigation_item) %>
  <% label = navigation_item.label_hidden? ? tag.span(navigation_item.label, class: "italic text-slate-400 dark:text-slate-500", title: "Only the icon shows on your blog") : navigation_item.label %>
  <div class="flex flex-1 items-center gap-2">
    <%= link_to_unless navigation_item.is_a?(SearchNavigationItem),
          safe_join([ (tag.span(icon, class: "flex size-4 shrink-0 *:size-full") if icon), label ]),
          edit_app_settings_navigation_item_path(navigation_item, anchor: "navigation-form"),
          class: "flex items-center gap-2 hover:underline" %>
  </div>
  <%= button_to app_settings_navigation_item_path(navigation_item),
      method: :delete,
      data: { turbo_confirm: "Remove this navigation item?" },
      title: "Delete this navigation item",
      aria: { label: "Delete this navigation item" },
      class: "text-slate-400 hover:text-red-600 cursor-pointer" do %>
    <%= inline_svg_tag "icons/trash.svg", class: "w-4 h-4" %>
  <% end %>
</div>
