<%= render "app/settings/header", title: "Delete Account", heading: "Delete your account", parent: "My Account", parent_path: edit_app_settings_account_path %>

<div>
  <%= settings_section do %>
    <div class="py-5 space-y-4 text-slate-800 dark:text-slate-200">
      <p>
        Your Pagecord account will be permanently deleted<%= " and your subscription cancelled, with no further charges" if Current.user.paying? %>. Sorry to see you go!
      </p>

      <%= form_with model: @cancellation, url: app_settings_account_deletion_path, class: "space-y-6 pt-2" do |form| %>
        <%= render "app/settings/cancellation_reasons", form: form, question: "Why are you leaving?" %>

        <div class="flex flex-wrap items-center gap-3">
          <%= form.submit "Delete account", class: "btn-danger", data: { turbo_confirm: "Are you absolutely sure? Your account will be incinerated!" } %>

          <%= link_to "I don't want to delete it", edit_app_settings_account_path, class: "btn-primary" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
