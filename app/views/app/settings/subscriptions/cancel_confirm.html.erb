<div class="space-y-8">
  <%= settings_section "Cancel Subscription" do %>
    <div class="px-6 py-5 space-y-4">
      <p>
        After cancelling, you will stay on Pagecord Premium until <strong><%= @subscription.next_billed_at.to_date.to_formatted_s(:long) %></strong>. After that, your account moves to Classic. Everything you've made stays exactly as it is – your posts, pages, custom CSS, footer and uploads all keep working. You'll lose custom domains, email subscribers, analytics, the API, the contact form, reply by email and human customer support. Pagecord branding reappears, and uploads are limited to <%= UploadQuota::FREE_LIMIT %> in total with no video.
      </p>

      <p>
        Are you sure about this?
      </p>

      <div class="flex items-center pt-2">
        <%= button_to "I understand. Cancel my subscription", app_settings_subscription_path(@subscription), method: :delete, class: "btn-danger", data: { turbo_confirm: "Are you absolutely sure?" } %>

        <%= link_to "I don't want to cancel", app_settings_path, class: "ms-4 text-sm font-medium underline" %>
      </div>
    </div>
  <% end %>
</div>
