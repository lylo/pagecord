<% content_for :head do %>
  <%= stylesheet_link_tag "codemirror", "codemirror-show-hint", "code-editor" %>
<% end %>

<% premium_disabled = !@blog.user.has_premium_access? %>
<% style_editor_data = premium_disabled ? {} : { controller: "code-editor" } %>
<% html_editor_data = premium_disabled ? {} : { controller: "code-editor", code_editor_mode_value: "htmlmixed" } %>
<% code_field_classes = "w-full min-h-36 rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-200 font-mono text-sm focus:border-slate-500 dark:focus:border-slate-400 focus:ring-0 [field-sizing:content]" %>

<div class="space-y-8">
  <div>
    <%= callout(:info) do %>
      <ul class="list-disc list-outside ps-4 space-y-1">
        <li>It's possible to break your blog with custom code. If that happens, come back here and remove it, or switch it off below.</li>
        <li>Be careful pasting code from somewhere you don't recognise, and prefer pasting code directly over linking to a third party where you can.</li>
        <li>Customer support for writing or debugging custom code is not possible, so you're on your own with this one.</li>
      </ul>
    <% end %>
  </div>

  <%= settings_section "Style", description: "Restyle your blog with your own CSS, and add a snippet to the bottom of every page." do %>
    <%= settings_row "Custom CSS", stacked: true do %>
      <div class="space-y-4">
        <div class="space-y-2">
          <p>
            Add custom CSS to style your blog. This CSS will be inserted into the <code>&lt;head&gt;</code> of your blog pages.
            You can use <code>@import</code> for Google Fonts or Bunny Fonts.
          </p>

          <p class="text-sm text-slate-500 italic">
            Read <%= link_to "the help guide", "https://help.pagecord.com/custom-css", class: "underline decoration-slate-300 underline-offset-2 hover:text-slate-700 dark:hover:text-slate-300", target: "_blank" %> to get started.
          </p>
        </div>

        <% if premium_disabled %>
          <%= callout(:info) do %>
            <%= link_to "Subscribe", app_settings_subscriptions_path, class: "underline font-medium" %> to style your blog with custom CSS.
          <% end %>
        <% end %>

        <%= form_with url: app_settings_custom_code_path, model: @blog,
              data: {
                controller: "save-button",
                action: "turbo:submit-end->save-button#showMessage"
              } do |form| %>
          <div class="space-y-4 <%= 'opacity-50' if premium_disabled %>">
            <div <%= tag.attributes(data: style_editor_data) %>>
              <%= form.text_area :custom_css, rows: 6, disabled: premium_disabled,
                  class: code_field_classes, data: { code_editor_target: "textarea" } %>
              <div id="css-error" class="field-error"><%= @blog.errors[:custom_css].first %></div>
            </div>

            <div>
              <%= form.submit "Save custom CSS", disabled: premium_disabled, data: { save_button_target: "button" }, class: "btn-primary" %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= settings_row "Custom Footer", stacked: true do %>
      <div class="space-y-4">
        <div class="space-y-2">
          <p>
            Add a small HTML snippet to the bottom of your blog for badges, webrings, links, or copyright text.
          </p>

          <p class="text-sm text-slate-500 italic">
            Only basic, safe HTML is supported. Scripts, embeds, forms, iframes, and inline styles are not supported. Read <%= link_to "the help guide", "https://help.pagecord.com/custom-footer", class: "underline decoration-slate-300 underline-offset-2 hover:text-slate-700 dark:hover:text-slate-300", target: "_blank" %> to get started.
          </p>
        </div>

        <% if premium_disabled %>
          <%= callout(:info) do %>
            <%= link_to "Subscribe", app_settings_subscriptions_path, class: "underline font-medium" %> to add a custom footer to your blog.
          <% end %>
        <% end %>

        <%= form_with url: app_settings_custom_code_path, model: @blog,
              data: {
                controller: "save-button",
                action: "turbo:submit-end->save-button#showMessage"
              } do |form| %>
          <div class="space-y-4 <%= 'opacity-50' if premium_disabled %>">
            <div <%= tag.attributes(data: html_editor_data) %>>
              <%= form.text_area :custom_footer_html, rows: 6, disabled: premium_disabled,
                  class: code_field_classes, data: { code_editor_target: "textarea" } %>
              <div id="footer-error" class="field-error"><%= @blog.errors[:custom_footer_html].first %></div>
            </div>

            <div>
              <%= form.submit "Save custom footer", disabled: premium_disabled, data: { save_button_target: "button" }, class: "btn-primary" %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if current_features.enabled?(:custom_code) %>
    <% custom_code_disabled = !@blog.user.subscribed? %>

    <%= settings_section "Scripts", description: "Add code to every page of your blog, for things Pagecord doesn't do itself." do %>
      <%= settings_row "Head Code", stacked: true do %>
        <div class="space-y-4">
          <div class="space-y-2">
            <p>
              Added just before the closing <code>&lt;head&gt;</code> tag of every page. Most people use it for third party
              analytics, or for a verification tag another service has asked them to add.
            </p>

            <p class="text-sm text-slate-500 italic">
              Only <code>&lt;script&gt;</code>, <code>&lt;style&gt;</code>, <code>&lt;link&gt;</code>, <code>&lt;meta&gt;</code>, <code>&lt;noscript&gt;</code> and <code>&lt;template&gt;</code> tags can go here. Read <%= link_to "the help guide", "https://help.pagecord.com/custom-code", class: "underline decoration-slate-300 underline-offset-2 hover:text-slate-700 dark:hover:text-slate-300", target: "_blank" %> to get started.
            </p>
          </div>

          <% if custom_code_disabled %>
            <%= callout(:info) do %>
              <%= link_to "Subscribe", app_settings_subscriptions_path, class: "underline font-medium" %> to add custom code to your blog.
            <% end %>
          <% end %>

          <%= form_with url: app_settings_custom_code_path, model: @blog,
                data: {
                  controller: "save-button",
                  action: "turbo:submit-end->save-button#showMessage"
                } do |form| %>
            <div class="space-y-4 <%= 'opacity-50' if custom_code_disabled %>">
              <div <%= tag.attributes(data: custom_code_disabled ? {} : html_editor_data) %>>
                <%= form.text_area :custom_head_html, rows: 6, disabled: custom_code_disabled,
                    spellcheck: false, autocapitalize: "off", autocorrect: "off", autocomplete: "off",
                    class: code_field_classes, data: { code_editor_target: "textarea" } %>
                <div id="head-error" class="field-error"><%= @blog.errors[:custom_head_html].first %></div>
              </div>

              <div>
                <%= form.submit "Save head code", disabled: custom_code_disabled, data: { save_button_target: "button" }, class: "btn-primary" %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= settings_row "Body Code", stacked: true do %>
        <div class="space-y-4">
          <div class="space-y-2">
            <p>
              Added just before the closing <code>&lt;body&gt;</code> tag of every page. Use it for anything your readers can see,
              like chat widgets and embedded forms.
            </p>

            <p class="text-sm text-slate-500 italic">
              Any HTML can go here. Read <%= link_to "the help guide", "https://help.pagecord.com/custom-code", class: "underline decoration-slate-300 underline-offset-2 hover:text-slate-700 dark:hover:text-slate-300", target: "_blank" %> to get started.
            </p>
          </div>

          <% if custom_code_disabled %>
            <%= callout(:info) do %>
              <%= link_to "Subscribe", app_settings_subscriptions_path, class: "underline font-medium" %> to add custom code to your blog.
            <% end %>
          <% end %>

          <%= form_with url: app_settings_custom_code_path, model: @blog,
                data: {
                  controller: "save-button",
                  action: "turbo:submit-end->save-button#showMessage"
                } do |form| %>
            <div class="space-y-4 <%= 'opacity-50' if custom_code_disabled %>">
              <div <%= tag.attributes(data: custom_code_disabled ? {} : html_editor_data) %>>
                <%= form.text_area :custom_body_html, rows: 6, disabled: custom_code_disabled,
                    spellcheck: false, autocapitalize: "off", autocorrect: "off", autocomplete: "off",
                    class: code_field_classes, data: { code_editor_target: "textarea" } %>
                <div id="body-error" class="field-error"><%= @blog.errors[:custom_body_html].first %></div>
              </div>

              <div>
                <%= form.submit "Save body code", disabled: custom_code_disabled, data: { save_button_target: "button" }, class: "btn-primary" %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="px-4 py-5 sm:px-6">
        <%= form_with url: app_settings_custom_code_path, model: @blog,
              data: { controller: "checkbox-auto-submit" } do |form| %>
          <div class="flex gap-3 <%= 'opacity-50' if custom_code_disabled %>">
            <div class="flex h-6 shrink-0 items-center">
              <%= styled_check_box form, :custom_code_enabled, disabled: custom_code_disabled %>
            </div>
            <div>
              <%= form.label :custom_code_enabled, "Head and body code enabled", class: "text-slate-800 dark:text-slate-100" %>
              <p class="text-slate-500 text-sm">
                Switch your code off without deleting it, so you can rule it out when something looks wrong on
                your blog.
              </p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<div class="mt-12">
  <%= link_to "Back to Settings", app_settings_path, class: "btn-secondary" %>
</div>
