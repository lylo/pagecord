<div class="flex grow flex-col">
  <h1 class="page-title">Your blogs</h1>
  <p class="mt-2 text-slate-600 dark:text-slate-300">Each blog has its own posts, pages and settings. Switch between them any time.</p>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    <% if @blogs.count < Current.user.blog_limit %>
      <%= link_to "Add Blog", new_app_blog_path, class: "btn-primary" %>
    <% else %>
      <% reason = Current.user.subscribed? ? "You can have up to #{Blog::MAX_BLOGS_PAID} blogs on your plan." : "Subscribe to Pagecord Premium to add up to #{Blog::MAX_BLOGS_PAID} blogs." %>
      <span class="btn-primary cursor-not-allowed opacity-50" title="<%= reason %>" aria-disabled="true">Add Blog</span>
    <% end %>
  </div>

  <div class="sheet-divider mt-5"></div>

  <% unless Current.user.subscribed? %>
    <div class="mt-6 mb-6 rounded-lg bg-slate-50 p-4 text-sm text-slate-600 dark:bg-slate-800/50 dark:text-slate-300">
      <%= link_to "Subscribe to Pagecord Premium", app_settings_subscriptions_path, class: "link-quiet font-medium" %> to add up to <%= Blog::MAX_BLOGS_PAID %> blogs to your account. Handy for a separate photo blog, microblog, or a private journal!
    </div>
  <% end %>

  <div class="divide-y divide-slate-200 dark:divide-slate-800">
    <% @blogs.each do |blog| %>
      <% current = blog.id == @blog.id %>
      <div class="group sheet-bleed flex items-center justify-between gap-3 border-s-2 py-5 <%= current ? "border-s-pagecord-accent" : "border-s-transparent" %>">
        <div class="flex min-w-0 items-center gap-3">
          <%= render "app/shared/blog_avatar", blog: blog, size: "md" %>
          <div class="min-w-0">
            <div class="truncate font-semibold text-slate-900 dark:text-slate-100"><%= blog.display_name %></div>
            <div class="truncate text-sm text-slate-500 dark:text-slate-400">
              <%= blog.subdomain %>.pagecord.com · <%= pluralize(blog.posts.count, "post") %><% if current %> · <span class="font-semibold text-pagecord-accent">Current</span><% end %>
            </div>
          </div>
        </div>

        <div class="flex shrink-0 items-center gap-2">
          <% unless current %>
            <%= button_to "Switch", app_blog_selection_path(blog), method: :post, form_class: "contents", class: "btn-optional" %>
          <% end %>

        <% if @blogs.count > 1 %>
          <% confirm_message = "Are you sure you want to delete #{blog.display_name}?" %>
          <%= button_to app_blog_path(blog), method: :delete,
              class: "btn-danger",
              form_class: "contents",
              form: { data: { turbo_confirm: confirm_message } } do %>
            Delete
          <% end %>
        <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% trashed_count = Current.user.all_blogs.discarded.count %>
  <% if trashed_count > 0 %>
    <div class="sheet-divider mt-auto pt-5">
      <%= link_to app_blogs_trash_path, class: "inline-flex items-center gap-1.5 text-sm text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300" do %>
        <%= inline_svg_tag "icons/trash.svg", class: "w-3.5 h-3.5" %>
        <%= pluralize trashed_count, "deleted blog" %>
      <% end %>
    </div>
  <% end %>
</div>
