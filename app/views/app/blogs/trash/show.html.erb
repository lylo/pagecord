<div class="sheet-header justify-between gap-x-3">
  <div class="flex min-w-0 items-center gap-x-2">
    <%= link_to "Blogs", app_blogs_path, class: "shrink-0 font-semibold text-slate-800 dark:text-slate-100 hover:underline" %>
    <span class="shrink-0 text-slate-400">&rsaquo;</span>
    <span class="min-w-0 truncate">Trash</span>
    <% if @trashed_blogs.any? %><%= pill @trashed_blogs.size %><% end %>
  </div>

  <% if @trashed_blogs.any? %>
    <%= link_to "Empty trash", app_blogs_trash_path,
          data: { turbo_method: :delete, turbo_confirm: "Permanently delete all blogs in the trash? This cannot be undone." },
          class: "link-quiet shrink-0 hover:text-slate-800 dark:hover:text-slate-200" %>
  <% end %>
</div>
<div class="sheet-band py-5">
  <p class="text-sm text-slate-500 dark:text-slate-400">Deleted blogs are kept for 30 days before being permanently removed.</p>
</div>

<% if @trashed_blogs.empty? %>
  <p class="py-8 text-center text-slate-600 dark:text-slate-300">Your trash is empty.</p>
<% else %>
  <div class="divide-y divide-slate-200 dark:divide-slate-800">
    <% @trashed_blogs.each do |blog| %>
      <div class="sheet-bleed flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 py-5">
        <div class="min-w-0">
          <div class="font-medium [overflow-wrap:anywhere] text-slate-900 dark:text-slate-100">
            <%= blog.display_name %>
          </div>
          <div class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">
            Deleted <%= time_ago_in_words(blog.discarded_at) %> ago
          </div>
        </div>

        <div class="flex shrink-0 items-center gap-x-2">
          <%= button_to "Restore", app_blog_restoration_path(blog), method: :post, title: "Restore #{blog.display_name}", class: "btn-primary" %>
          <%= button_to "Delete forever", app_blog_path(blog), method: :delete, data: { turbo_confirm: "Permanently delete this blog? This cannot be undone." }, title: "Permanently delete #{blog.display_name}", class: "btn-danger" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
