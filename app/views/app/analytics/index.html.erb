<% disabled = "pointer-events-none select-none opacity-30" unless Current.user.has_premium_access? %>

<div class="relative space-y-6">
  <div class="<%= disabled %>">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Analytics</h1>

    <div class="mt-3 flex flex-wrap items-center gap-2">
      <div class="btn-group">
        <% %w[ day month year ].each do |view| %>
          <%= link_to view.titleize, nav_path_for_date(view, date_for_view(@date, @view_type, view)),
                class: class_names("btn-group-item", "btn-group-item-active": @view_type == view) %>
        <% end %>
      </div>

      <div class="flex basis-full items-center gap-x-2 sm:ms-auto sm:basis-auto">
        <% unless current_period?(@date, @view_type) %>
          <%= link_to "Today", nav_path_for_date(@view_type, Date.current), class: "btn-optional", title: "Jump to current #{@view_type}" %>
        <% end %>

        <div class="flex items-center gap-x-1">
          <%= link_to nav_path_for_date(@view_type, previous_date(@date, @view_type)), class: "btn-icon", title: "Previous #{@view_type}", aria: { label: "Previous #{@view_type}" } do %>
            <%= inline_svg_tag "icons/chevron-left.svg", class: "w-4 h-4" %>
          <% end %>

          <span class="min-w-32 text-center text-sm font-medium text-slate-900 dark:text-slate-100">
            <%= format_date_for_view_type(@date, @view_type) %>
          </span>

          <% if next_date(@date, @view_type) > Date.current %>
            <span class="btn-icon pointer-events-none opacity-30" aria-hidden="true">
              <%= inline_svg_tag "icons/chevron-right.svg", class: "w-4 h-4" %>
            </span>
          <% else %>
            <%= link_to nav_path_for_date(@view_type, next_date(@date, @view_type)), class: "btn-icon", title: "Next #{@view_type}", aria: { label: "Next #{@view_type}" } do %>
              <%= inline_svg_tag "icons/chevron-right.svg", class: "w-4 h-4" %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="sheet-divider mt-5"></div>
  </div>

  <%= trial_callout("Analytics") %>

  <div class="<%= disabled %> space-y-6">
    <div>
      <h3 class="text-sm font-medium text-slate-500 dark:text-slate-400">Page Views</h3>
      <p class="text-3xl font-bold text-slate-900 dark:text-slate-100 mt-2">
        <%= format_number(@analytics_data[:unique_page_views]) %>
      </p>
    </div>

    <div class="sheet-divider"></div>

    <%= render 'chart' %>

    <div class="sheet-divider"></div>

    <%= render 'leaderboard' %>

    <div class="sheet-divider"></div>

    <%= render 'referrers' %>

    <div class="sheet-divider"></div>

    <%= render 'countries' %>
  </div>

  <%= render 'premium_overlay' unless Current.user.has_premium_access? %>
</div>