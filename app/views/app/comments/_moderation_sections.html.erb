<% if @pending.empty? && @approved.empty? %>
  <%= render @post ? "post_blank_slate" : "blank_slate" %>
<% else %>
  <div class="space-y-8">
    <% if @pending.any? %>
      <%= render "pending_section" %>
    <% end %>

    <% if @approved.any? %>
      <%= render "approved_section" %>
    <% end %>
  </div>
<% end %>
