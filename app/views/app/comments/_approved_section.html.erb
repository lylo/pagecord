<% if @approved.any? %>
  <div class="divide-y divide-slate-200 dark:divide-slate-800">
    <%= render partial: "app/comments/approved_comment", collection: @approved, as: :comment %>
  </div>

  <%= render "app/shared/pagy_nav" %>
<% else %>
  <p class="py-8 text-center text-slate-600 dark:text-slate-300">No approved comments yet.</p>
<% end %>
