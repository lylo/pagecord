<% if @pending.any? %>
  <div class="divide-y divide-slate-200 dark:divide-slate-800">
    <%= render partial: "app/comments/pending_comment", collection: @pending, as: :comment %>
  </div>
<% else %>
  <p class="py-8 text-center text-slate-600 dark:text-slate-300">Nothing waiting for you.</p>
<% end %>
