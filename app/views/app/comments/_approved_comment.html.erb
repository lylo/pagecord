<% replied = comment.author_reply.present? %>

<article class="<%= class_names(
  "sheet-bleed border-s-2 py-5",
  "border-s-pagecord-accent bg-slate-50 dark:bg-slate-800/60": replied,
  "border-s-transparent": !replied
) %>">
  <% if replied %>
    <span class="sr-only">You replied to this comment.</span>
  <% end %>

  <%= render "app/comments/comment_header", comment: comment %>

  <p class="mt-2 line-clamp-3 whitespace-pre-line text-base leading-7 text-slate-600 dark:text-slate-400"><%= comment.message %></p>
</article>
