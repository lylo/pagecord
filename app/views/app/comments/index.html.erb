<% if @post %>
  <div class="sheet-header gap-x-2">
    <%= link_to "Comments", app_comments_path, class: "shrink-0 font-semibold text-slate-800 dark:text-slate-100 hover:underline" %>
    <span class="shrink-0 text-slate-400">&rsaquo;</span>
    <%= link_to @post.display_title, edit_app_post_path(@post), class: "min-w-0 truncate hover:underline" %>
    <%= link_to post_url(@post), target: "_blank", rel: "noopener", title: "View published post",
          aria: { label: "View published post" },
          class: "shrink-0 text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" do %>
      <%= inline_svg_tag "icons/arrow-top-right-on-square.svg", class: "h-3.5 w-3.5 align-top" %>
    <% end %>
  </div>
<% elsif @pending.any? || @approved.any? %>
  <h1 class="page-title">Comments</h1>
<% end %>

<div id="comments_moderation" class="flex grow flex-col">
  <%= render "app/comments/moderation_sections" %>
</div>
