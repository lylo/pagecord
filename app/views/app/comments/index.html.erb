<div class="mx-auto max-w-3xl w-full text-slate-950 dark:text-slate-50">
  <div class="my-8">
    <% if @post %>
      <header class="mb-8">
        <div class="flex items-start gap-2">
          <h2 class="min-w-0 text-lg font-normal leading-7 text-slate-500 dark:text-slate-400">
            Comments for
            <%= link_to @post.display_title, edit_app_post_path(@post),
                  class: "font-semibold text-slate-900 hover:underline dark:text-slate-100" %>
          </h2>
          <%= link_to post_url(@post), target: "_blank", rel: "noopener", title: "View published post",
                aria: { label: "View published post" },
                class: "mt-1.5 shrink-0 text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" do %>
            <%= inline_svg_tag "icons/arrow-top-right-on-square.svg", class: "h-4 w-4" %>
          <% end %>
        </div>
      </header>
    <% end %>

    <div id="comments_moderation">
      <%= render "app/comments/moderation_sections" %>
    </div>
  </div>
</div>
