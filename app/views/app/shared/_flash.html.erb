<% unless flash.empty? %>
<div class="hidden pointer-events-none fixed inset-x-4 bottom-6 z-50 flex justify-center" data-controller="fade" data-fade-duration-value="<%= flash[:error] ? 6000 : 3000 %>">
  <div class="<%= class_names("max-w-md rounded-full px-5 py-2.5 text-sm font-medium shadow-lg", flash[:error] ? "bg-red-600 text-white" : "bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900") %>">
    <%= flash.map { |_type, message| message }.join(" ") %>
  </div>
</div>
<% end %>
