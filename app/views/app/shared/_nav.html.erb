<nav class="absolute left-0 top-full z-50 mt-2 hidden w-64 md:left-1/2 md:top-1/2 md:mt-0 md:block md:w-auto md:-translate-x-1/2 md:-translate-y-1/2" data-toggle-target="element">
  <ul role="list" class="flex flex-col rounded-lg border border-slate-200 bg-white py-2 text-sm text-slate-600 shadow-md dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:shadow-black/40 md:inline-flex md:w-max md:flex-row md:items-center md:rounded-full md:border-0 md:p-1 md:shadow-[0_1px_2px_rgba(0,0,0,0.06)]">
    <li>
      <%= link_to "Posts", app_posts_path, **nav_link_attributes("posts") %>
    </li>
    <li>
      <%= link_to "Pages", app_pages_path, **nav_link_attributes("pages") %>
    </li>
    <% if @blog.accepts_comments? %>
      <li>
        <%= link_to app_comments_path, **nav_link_attributes("comments") do %>
          Comments
          <span id="comments_nav_pending_count"><%= render "app/comments/pending_count" %></span>
        <% end %>
      </li>
    <% end %>
    <% if @blog.show_metrics? %>
      <li>
        <%= link_to "Analytics", app_analytics_path, **nav_link_attributes("analytics") %>
      </li>
    <% end %>
    <li>
      <%= link_to "Settings", app_settings_path, **nav_link_attributes("settings") %>
    </li>
  </ul>
</nav>
