<% unless quota.unlimited? %>
  <% if quota.exceeded? %>
    <div class="mb-4">
      <%= callout(:info) do %>
        You've used all <%= UploadQuota::FREE_LIMIT %> free uploads.
        <%= link_to "Subscribe", app_settings_subscriptions_path, class: "underline font-medium" %> to upload more.
      <% end %>
    </div>
  <% else %>
    <p class="mb-4 text-sm text-slate-500 dark:text-slate-400">
      <%= quota.used %> of <%= UploadQuota::FREE_LIMIT %> free uploads used
    </p>
  <% end %>
<% end %>
