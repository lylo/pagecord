<%# locals: (number:, title:, description: nil) %>
<div class="sheet-divider pt-6">
  <div class="flex items-center gap-3">
    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-pagecord-accent text-base font-bold text-white"><%= number %></span>
    <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100"><%= title %></h2>
  </div>
  <% if description %>
    <p class="mt-2 text-slate-600 dark:text-slate-300"><%= description %></p>
  <% end %>
</div>
