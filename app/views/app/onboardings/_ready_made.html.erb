<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
  <% templates.each do |template| %>
    <%= render "app/settings/theme_garden/template_card",
          template: template,
          apply_path: app_onboarding_theme_path,
          apply_method: :patch,
          apply_params: { template_id: template.id },
          save_message: "✅ Applied!" %>
  <% end %>
</div>

<div class="mt-6">
  <%= link_to "See all designs", app_settings_theme_garden_index_path, class: "btn-optional" %>
</div>
