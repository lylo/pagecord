<div class="text-slate-800 dark:text-slate-200">
  <div class="pb-6">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100">Welcome to Pagecord! ✨</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-300">
      Your blog is live at <%= link_to blog_home_url(@blog), blog_home_url(@blog), class: "link-quiet font-semibold" %>.
    </p>

    <p class="mt-2 text-slate-600 dark:text-slate-300">
      Five quick things to set up. You can change any of them later in Settings.
    </p>
  </div>

  <%= render "step", number: "1", title: "Give your blog a title" %>

  <div class="py-6">
    <%= form_with url: app_onboarding_path, model: @blog,
          data: {
            turbo_scroll: false,
            controller: "save-button",
            action: "turbo:submit-end->save-button#showMessage"
          } do |form| %>
      <fieldset>
        <%= styled_text_field(form, :title, placeholder: "@#{@blog.subdomain}", class: "w-full") %>
        <div class="field-error"><%= @blog.errors[:title].first if @blog.errors[:title].any? %></div>
      </fieldset>

      <%= form.submit "Save",
        data: {
          save_button_target: "button",
          save_button_message_value: "✅ Saved!"
        },
        class: "mt-2 btn-primary"
      %>
    <% end %>
  </div>

  <%= render "step", number: "2", title: "Add a bio",
        description: "Your bio appears at the top of your blog's home page. Entirely optional." %>

  <div class="lexxy-minimal py-6">
    <%= form_with url: app_onboarding_path, model: @blog,
          data: {
            turbo_scroll: false,
            controller: "save-button",
            action: "turbo:submit-end->save-button#showMessage"
          } do |form| %>

      <fieldset>
        <%= form.rich_text_area :bio,
          placeholder: "Add your bio...",
          class: "lexxy-content min-h-[150px]",
          spellcheck: true,
          autocorrect: "on",
          autocapitalize: "sentences",
          attachments: false,
          data: { subscribed: false } %>

        <div id="bio_error" class="field-error"><%= render "bio_error" if @blog.errors[:bio].any? %></div>
      </fieldset>

      <%= form.submit "Save",
        data: { save_button_target: "button" },
        class: "mt-2 btn-primary"
      %>
    <% end %>
  </div>

  <%= render "step", number: "3", title: "Choose a design ✨",
        description: "Pick a ready-made design, or choose your own colours, type and layout." %>

  <div class="py-6">
  <div data-controller="tabs" data-tabs-active-class="btn-group-item-active">
    <div class="btn-group">
      <button type="button" data-tabs-target="tab" data-action="tabs#select" data-tabs-index-param="0" class="btn-group-item btn-group-item-active">
        Ready-made design
      </button>
      <button type="button" data-tabs-target="tab" data-action="tabs#select" data-tabs-index-param="1" class="btn-group-item">
        Choose your own
      </button>
    </div>

    <div data-tabs-target="panel" class="pt-6 pb-2">
      <%= render "ready_made", templates: @featured_templates %>
    </div>

    <div data-tabs-target="panel" class="hidden pt-6 pb-2 space-y-8">
      <div>
        <h3 class="text-lg font-semibold">Pick a colour scheme 🎨</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">The default is the classic Pagecord minimal monochrome.</p>
        <%= form_with url: app_onboarding_path, model: @blog, data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |form| %>
          <%= render "/app/settings/appearance/theme_colour", form: form %>
        <% end %>
      </div>

      <div>
        <h3 class="text-lg font-semibold">Choose a typeface</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">Choose whether you'd like a sans-serif font, or serif for that elegant look.</p>
        <%= form_with url: app_onboarding_path, model: @blog, data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |form| %>
          <%= render "/app/settings/appearance/theme_font", form: form %>
        <% end %>
      </div>

      <div>
        <h3 class="text-lg font-semibold">Choose your blog layout</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">The default is a stream of all your posts on the home page. You can also choose a list of post titles and dates, or cards with excerpts.</p>
        <%= form_with url: app_onboarding_path, model: @blog, data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |form| %>
          <%= render "/app/settings/appearance/layout_options", form: form %>
        <% end %>
      </div>

      <div>
        <h3 class="text-lg font-semibold">Choose a page width</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">Choose whether you'd like the standard layout, or one that's wider or narrower.</p>
        <%= form_with url: app_onboarding_path, model: @blog, data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |form| %>
          <%= render "/app/settings/appearance/layout_width", form: form %>
        <% end %>
      </div>
    </div>
  </div>
  </div>

  <%= render "step", number: "4", title: "Choose your language",
        description: "The interface language of your blog, used for buttons, forms and dates." %>

  <div class="py-6">
    <%= form_with url: app_onboarding_path, model: @blog, data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |form| %>
      <%= render "/app/settings/blogs/language_select", form: form %>
    <% end %>
  </div>

  <%= render "step", number: "5", title: "Ready to write ✍️",
        description: "Publish your first post in the editor, from Obsidian, or straight from your inbox." %>

  <div class="py-6">
    <%= button_to app_onboarding_completion_path, class: "btn-primary" do %>
      Go to your blog and start writing →
    <% end %>
  </div>
</div>
