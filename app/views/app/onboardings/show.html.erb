<% content_for :title, "Pagecord - Welcome" %>
<% content_for :footer do %>Your blog: <%= link_to blog_home_url(@blog), blog_home_url(@blog) %><% end %>

<div class="letter-intro">
  <h1>Welcome to Pagecord</h1>
  <p>It's great to have you here! Let's get you set up.</p>
</div>

<div class="letter-paper letter-paper--reply">
  <%= render "letters/letterhead" %>

  <p>Dear <%= @blog.display_name %>,</p>
  <p>
    Your blog is live at
    <%= link_to @blog.host, blog_home_url(@blog), target: "_blank" %>,
    and ready when you are.
  </p>

  <%= form_with url: app_onboarding_theme_path, method: :patch, data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |form| %>
    <fieldset>
      <legend>First, pick a design for your blog:</legend>

      <div class="letter-stationery">
        <% @templates.each do |template| %>
          <label class="letter-sheet">
            <%= form.radio_button :template_id, template.id, checked: @blog.custom_css == template.custom_css, class: "sr-only" %>
            <% if template.screenshot? %>
              <%= image_tag template.screenshot_asset, alt: "", loading: "lazy" %>
            <% else %>
              <span class="letter-sheet__blank"></span>
            <% end %>
            <span class="letter-postmark" aria-hidden="true"></span>
            <%= template.name %>
          </label>
        <% end %>

        <label class="letter-sheet">
          <%= form.radio_button :template_id, "", checked: @blog.custom_css.blank?, class: "sr-only" %>
          <span class="letter-sheet__blank"></span>
          <span class="letter-postmark" aria-hidden="true"></span>
          Classic
        </label>
      </div>
    </fieldset>
  <% end %>

  <%= form_with model: @blog, url: app_onboarding_completion_path, method: :post do |form| %>
    <p>You can add a bio to the top of your blog, if you like:</p>
    <p>
      <%= letter_blank form, :bio, label: "Bio", as: :text_area, size: :bio, value: @blog.bio.to_plain_text, maxlength: 500, rows: 2,
            placeholder: "a little about you or your blog" %>
    </p>
    <p class="letter-note" role="alert"><%= @blog.errors.full_messages_for(:bio).first %></p>
    <p>
      You'll be writing in
      <%= form.label :locale, "Language", class: "sr-only" %>
      <%= form.select :locale, Blog.available_locales, {}, class: "letter-blank letter-blank--select" %>.
    </p>
    <p>All of this can be changed in Settings whenever you like.</p>

    <p>Yours,</p>
    <p class="letter-signature">Olly</p>

    <p class="letter-ps">
      P.S. You can post by email too. Just write to <span class="letter-address"><%= @blog.delivery_email %></span>
    </p>

    <div class="letter-send">
      <%= render "letters/send", form: form, label: "Take me to Pagecord" %>
    </div>
  <% end %>
</div>
