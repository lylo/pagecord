<% is_new = !@page.persisted? %>
<% quota = Current.user.upload_quota %>

<div data-controller="settings-panel autosave"
    data-autosave-key-value="<%= is_new ? "draft-page-new-#{@blog.id}" : "draft-page-#{@page.id}" %>"
    data-autosave-base-title-value="<%= @page.title.to_s %>"
    data-autosave-base-content-value="<%= h(@page.content&.body&.to_html.to_s) if @page.persisted? %>">


  <%= form_with(model: @page, url: @page.persisted? ? app_page_path(@page) : app_pages_path, html: { id: "page-form" }) do |form| %>
    <%= hidden_field_tag :context_blog_id, @blog.id if is_new %>

    <%= render "settings_panel", form: form %>

    <div class="sheet-header mb-6 flex-wrap justify-between gap-x-3 gap-y-2">
      <div class="hidden sm:flex items-center gap-x-2 min-w-0">
        <%= render "app/shared/help/edit_page" %>
      </div>
      <div class="flex flex-wrap items-center justify-end gap-2 ms-auto">
        <%= render "app/posts/settings_button", record: @page, label: "Page settings" %>
        <%= link_to (is_new ? "Discard" : "Cancel"), app_pages_path,
              class: "btn-optional",
              data: { action: "click->autosave#cancel" } %>
        <%= form.button draft_button_text(@page), name: "post[status]", value: "draft", class: "btn-optional" %>
        <%= render "app/posts/publish_button", form: form, record: @page %>
      </div>
    </div>

    <fieldset>
      <%= render "app/posts/title_field", form: form %>
      <div class="field-error"><%= @page.errors.full_messages_for(:title).to_sentence %></div>
    </fieldset>

    <fieldset>
      <div class="field-error"><%= @page.errors.full_messages_for(:content).first %></div>
      <%= form.rich_text_area :content,
        placeholder: "Write your page content...",
        class: "lexxy-content lexxy-borderless mt-4",
        spellcheck: true,
        autocorrect: "on",
        autocapitalize: "sentences",
        data: { controller: "lexxy ios-toolbar", autosave_target: "content", attachments: !quota.exceeded?, videos: quota.unlimited? } %>

    </fieldset>

    <%= render "app/shared/upload_quota", quota: quota %>
  <% end %>
</div>
