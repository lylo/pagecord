<div class="sheet-band border-b-0 -mt-(--sheet-padding) -mb-4 rounded-lg py-6 sm:-mb-6">
  <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-50">Create your first page ✨</h1>
  <p class="mt-2 text-slate-600 dark:text-slate-300">
    Pages are for standalone parts of your site, like an About, Contact, or Now page. Once you've created one, you can add it to your navigation in <%= link_to "Navigation settings", app_settings_navigation_items_path, class: "link-quiet font-medium hover:text-slate-800 dark:hover:text-slate-200" %>.
  </p>

  <div class="mt-4 flex flex-wrap gap-2">
    <%= link_to "✏️ New Page", new_app_page_path, class: "btn-primary", title: "Create a new page" %>
    <% unless @blog.has_custom_home_page? %>
      <%= link_to "🏠 Create Home Page", new_app_home_page_path, class: "btn-secondary", title: "Create a blank home page" %>
    <% end %>
  </div>
</div>
