<div class="relative isolate flex grow flex-col items-center pt-10 pb-12 text-center sm:pt-16">
  <div class="relative flex items-end justify-center" aria-hidden="true">
    <% { "About" => "-rotate-8 translate-y-4", "Now" => "z-10 -mx-6 -translate-y-2", "Contact" => "rotate-8 translate-y-4" }.each do |name, tilt| %>
      <div class="<%= class_names("paper-sheet w-32 px-4 pt-4 pb-7 text-start sm:w-40", tilt) %>">
        <p class="font-hand text-2xl font-bold leading-none text-pagecord-accent-deep sm:text-3xl"><%= name %></p>
        <div class="mt-3 space-y-2">
          <div class="paper-sheet__rule"></div>
          <div class="paper-sheet__rule"></div>
          <div class="paper-sheet__rule w-1/2"></div>
        </div>
      </div>
    <% end %>
  </div>

  <h2 class="mt-12 text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">Create your first page</h2>
  <p class="mt-2 max-w-sm text-slate-600 dark:text-slate-300">
    Pages are for the parts of your site that stay put: who you are, what you're up to, how to get in touch.
  </p>

  <div class="mt-6 flex flex-wrap justify-center gap-2">
    <%= render "new_buttons" %>
  </div>

  <%= render "app/shared/first_steps" %>
</div>
