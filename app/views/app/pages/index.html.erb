<% if @pages.empty? && @drafts.empty? %>
  <%= render "blank_slate" %>
<% else %>
  <div class="sheet-header justify-between gap-2">
    <div class="flex flex-wrap items-center justify-end gap-2 ms-auto">
      <% unless @blog.has_custom_home_page? %>
        <%= link_to "🏠 Create Home Page", new_app_home_page_path, class: "btn-secondary", title: "Create a blank home page" %>
      <% end %>
      <%= link_to "✏️ New Page", new_app_page_path, class: "btn-primary", title: "Create a new page" %>
    </div>
  </div>
<% end %>

<% if @drafts.any? || @pages.any? %>
  <div class="sheet-band flex items-end justify-between gap-2 pt-2">
    <div class="flex gap-1">
      <%= button_to app_pages_tab_path, method: :patch, params: { tab: "published" }, form_class: "contents",
            class: class_names("tab", "tab-active": @tab == "published") do %>
        Published <%= pill @pages.size %>
      <% end %>
      <%= button_to app_pages_tab_path, method: :patch, params: { tab: "drafts" }, form_class: "contents",
            class: class_names("tab", "tab-active": @tab == "drafts") do %>
        Drafts <%= pill @drafts.size %>
      <% end %>
    </div>
    <% if @tab == "published" %>
      <div class="pb-2"><%= render "sort_toggle" %></div>
    <% end %>
  </div>

  <% if @tab == "drafts" %>
    <div id="draft_pages" class="pt-4 pb-4">
      <% @drafts.each do |page| %>
        <%= render "page", page: page,
              link: blog_post_preview_url(page.signed_id(purpose: :preview), host: page.blog.host), link_title: "Preview draft" %>
      <% end %>
      <% if @drafts.empty? %>
        <p class="py-6 text-center text-slate-600 dark:text-slate-300">No drafts.</p>
      <% end %>
    </div>
  <% else %>
    <div class="pt-4 pb-4">
      <% @pages.each do |page| %>
        <%= render "page", page: page, link: post_url(page), link_title: "View this page" %>
      <% end %>
      <% if @pages.empty? %>
        <p class="py-6 text-center text-slate-600 dark:text-slate-300">Nothing published yet.</p>
      <% end %>
    </div>
  <% end %>
<% end %>

<% trashed_count = @blog.pages.discarded.count %>
<% if trashed_count > 0 %>
  <div class="sheet-divider mt-auto pt-5">
    <%= link_to app_pages_trash_path, class: "inline-flex items-center gap-1.5 text-sm text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300" do %>
      <%= inline_svg_tag "icons/trash.svg", class: "w-3.5 h-3.5" %>
      <%= pluralize trashed_count, "deleted page" %>
    <% end %>
  </div>
<% end %>
