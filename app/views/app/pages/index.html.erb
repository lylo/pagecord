<% if @pages.empty? && @drafts.empty? %>
  <%= render "blank_slate" %>
<% else %>
  <div class="sheet-header justify-between gap-x-3">
    <%= render "app/shared/blog_link" %>
    <%= render "sort_toggle" if @tab == "published" %>
  </div>

  <h1 class="mt-6 page-title">Pages</h1>

  <div class="mt-3 flex flex-wrap items-center gap-2">
    <%= link_to "New Page", new_app_page_path, class: "btn-primary", title: "Create a new page" %>
    <% unless @blog.has_custom_home_page? %>
      <%= link_to "Create Home Page", new_app_home_page_path, class: "btn-optional", title: "Create a blank home page" %>
    <% end %>

    <div class="btn-group">
      <%= link_to app_pages_path(tab: "published"), class: class_names("btn-group-item", "btn-group-item-active": @tab == "published") do %>
        Published <%= pill @pages.size %>
      <% end %>
      <%= link_to app_pages_path(tab: "drafts"), class: class_names("btn-group-item", "btn-group-item-active": @tab == "drafts") do %>
        Drafts <%= pill @drafts.size %>
      <% end %>
    </div>
  </div>

  <div class="sheet-divider mt-5"></div>

  <% if @tab == "drafts" %>
    <div id="draft_pages" class="pt-4 pb-4">
      <% @drafts.each do |page| %>
        <%= render "page", page: page,
              link: blog_post_preview_url(page.signed_id(purpose: :preview), host: page.blog.host), link_title: "Preview draft" %>
      <% end %>
      <% if @drafts.empty? %>
        <p class="py-6 text-center text-slate-600 dark:text-slate-300">No drafts.</p>
      <% end %>
    </div>
  <% else %>
    <div class="pt-4 pb-4">
      <% @pages.each do |page| %>
        <%= render "page", page: page, link: post_url(page), link_title: "View this page" %>
      <% end %>
      <% if @pages.empty? %>
        <p class="py-6 text-center text-slate-600 dark:text-slate-300">Nothing published yet.</p>
      <% end %>
    </div>
  <% end %>
<% end %>

<% trashed_count = @blog.pages.discarded.count %>
<% if trashed_count > 0 %>
  <div class="sheet-divider mt-auto pt-5">
    <%= link_to app_pages_trash_path, class: "inline-flex items-center gap-1.5 text-sm text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300" do %>
      <%= inline_svg_tag "icons/trash.svg", class: "w-3.5 h-3.5" %>
      <%= pluralize trashed_count, "deleted page" %>
    <% end %>
  </div>
<% end %>
