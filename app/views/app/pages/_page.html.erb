<%# locals: (page:, link:, link_title:) %>
<div class="group flex items-center justify-between gap-3 -mx-2 rounded-md px-2 py-1 hover:bg-slate-50 dark:hover:bg-slate-800/60">
  <%= link_to (page.home_page? ? edit_app_home_page_path : edit_app_page_path(page)), title: "Click to edit this page", class: "flex min-w-0 items-center gap-2" do %>
    <% if page.home_page? %>
      <span title="This page is your home page">🏠</span>
    <% end %>
    <div class="truncate font-medium text-slate-900 group-hover:underline dark:text-slate-100">
      <%= page.display_title %>
    </div>
  <% end %>

  <%= link_to link, title: link_title, target: "_blank", data: { turbo_frame: "_top" }, class: "text-slate-400 transition-colors group-hover:text-slate-500 hover:text-slate-600 dark:text-slate-400 dark:group-hover:text-slate-300 dark:hover:text-slate-200" do %>
    <%= inline_svg_tag "icons/arrow-top-right-on-square.svg", class: "h-4 w-4" %>
  <% end %>
</div>
