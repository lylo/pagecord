<%# locals: (form:) %>
<%= render layout: "app/posts/settings_drawer", locals: { title: "Page settings" } do %>
  <div class="mb-8" data-section="slug">
    <div class="mt-4 font-bold">
    <%= form.label :slug, "Slug" %>
    </div>

    <fieldset class="mt-2">
      <%= form.text_field :slug,
          class: "w-full placeholder-slate-300 dark:placeholder-slate-600 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-slate-200 rounded-lg",
          placeholder: "custom-url-path" %>
      <div class="field-error"><%= @page.errors[:slug].to_sentence if @page.errors[:slug].any? %></div>
    </fieldset>
  </div>

  <div class="mb-8" data-section="visibility">
    <div class="mt-4 font-bold">
      Page Visibility
    </div>

    <div class="mt-4 flex gap-3">
      <div class="flex h-6 shrink-0 items-center">
        <%= form.check_box :hidden, class: "form-checkbox h-5 w-5 text-slate-600 border-slate-300 dark:border-slate-600 dark:bg-slate-700 rounded focus:ring focus:ring-slate-300 dark:focus:ring-slate-600 focus:ring-offset-0" %>
      </div>
      <div>
        <%= form.label :hidden, "Hide this page on my blog", class: "text-sm text-slate-800 dark:text-slate-100" %>
        <p class="text-slate-500 text-sm">
          When checked, this page will not be visible on your blog or in the sitemap, but it can be accessed via its link.
        </p>
      </div>
    </div>
  </div>

  <%= render "app/posts/open_graph_image_section", record: @page, form: form, revealed: true %>

  <div class="mt-8 pt-6 pb-4 border-t border-slate-200 dark:border-slate-700 flex justify-between gap-x-2">
    <% if @page.persisted? %>
      <%= link_to "Delete page", app_pages_trash_path(page_token: @page.token), class: "btn-danger", data: { turbo_method: :post, turbo_confirm: "Are you sure you want to delete this page?" } %>
    <% end %>
    <button type="button" class="btn-optional ms-auto sm:hidden" data-action="settings-panel#close">Done</button>
  </div>
<% end %>
