<%= link_to @show_info ? "Hide details" : "Show details",
      app_posts_path(info: @show_info ? "off" : "on", search: @search_term.presence, page: params[:page]),
      aria: { pressed: @show_info.to_s },
      data: { turbo_frame: "_top" },
      class: "shrink-0 text-sm underline decoration-slate-300 underline-offset-2 text-slate-500 hover:text-slate-700 hover:decoration-slate-500 dark:text-slate-400 dark:decoration-slate-600 dark:hover:text-slate-200 dark:hover:decoration-slate-300" %>
