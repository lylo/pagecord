<div class="sheet-header gap-x-2">
  <%= link_to "Posts", app_posts_path, class: "shrink-0 font-semibold text-slate-800 dark:text-slate-100 hover:underline" %>
  <span class="shrink-0 text-slate-400">&rsaquo;</span>
  <span class="min-w-0 truncate">Trash</span>
</div>

<div class="mt-6 flex items-center gap-3">
  <h1 class="page-title">Deleted posts</h1>
  <% if @trashed_posts.any? %><%= pill @trashed_posts.size, class: "mt-1" %><% end %>
</div>
<p class="mt-2 text-slate-600 dark:text-slate-300">Deleted posts are kept for 30 days before being permanently removed.</p>

<% if @trashed_posts.any? %>
  <div class="mt-5 flex flex-wrap items-center gap-2">
    <%= link_to "Empty trash", app_posts_trash_path, class: "btn-danger",
          data: { turbo_method: :delete, turbo_confirm: "Permanently delete all posts in the trash? This cannot be undone." } %>
  </div>
<% end %>

<div class="sheet-divider mt-5"></div>

<% if @trashed_posts.empty? %>
  <div class="flex grow flex-col items-center pt-8 pb-16 sm:pt-14">
    <p class="max-w-md text-slate-600 dark:text-slate-300">Your trash is empty.</p>
  </div>
<% else %>
  <div class="divide-y divide-slate-200 dark:divide-slate-800">
    <% @trashed_posts.each do |post| %>
      <div class="sheet-bleed flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 py-5">
        <div class="min-w-0">
          <div class="font-medium [overflow-wrap:anywhere] text-slate-900 dark:text-slate-100">
            <%= post.display_title %>
          </div>
          <div class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">
            Deleted <%= time_ago_in_words(post.discarded_at) %> ago
          </div>
        </div>

        <div class="flex shrink-0 items-center gap-x-2">
          <%= button_to "Restore", app_post_restoration_path(post), method: :post, title: "Restore #{post.display_title}", class: "btn-primary" %>
          <%= button_to "Delete forever", app_post_path(post), method: :delete, data: { turbo_confirm: "Permanently delete this post? This cannot be undone." }, title: "Permanently delete #{post.display_title}", class: "btn-danger" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
