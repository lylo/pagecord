<%# locals: (title:) %>
<div class="group" data-settings-panel-target="panel">
  <div class="fixed inset-0 z-40 bg-slate-950/25 dark:bg-slate-950/60 invisible opacity-0 transition-all duration-200 motion-reduce:transition-none group-data-open:visible group-data-open:opacity-100" data-action="click->settings-panel#close"></div>
  <div class="fixed z-50 inset-x-0 bottom-0 max-h-[85vh] rounded-t-2xl sm:inset-y-0 sm:inset-x-auto sm:right-0 sm:w-[400px] sm:max-h-none sm:rounded-none overflow-y-auto bg-white dark:bg-slate-900 dark:border-t dark:sm:border-t-0 dark:sm:border-l dark:border-slate-700 shadow-xl invisible translate-y-full sm:translate-y-0 sm:translate-x-full transition-all duration-200 ease-out motion-reduce:transition-none group-data-open:visible group-data-open:translate-y-0 group-data-open:translate-x-0">
    <div class="sticky top-0 z-10 flex items-center justify-between px-6 py-4 bg-slate-100 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
      <h2 class="text-lg font-bold"><%= title %></h2>
      <button type="button" class="text-slate-500 cursor-pointer hover:text-black dark:text-slate-300 dark:hover:text-slate-50" title="Close (Esc)" data-action="settings-panel#close">
        <%= inline_svg_tag "icons/close.svg", class: "w-5 h-5" %>
      </button>
    </div>
    <div class="px-6 pb-4">
      <%= yield %>
    </div>
  </div>
</div>
