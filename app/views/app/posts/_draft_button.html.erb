<%# locals: (form:, record:) %>
<% published = record.persisted? && record.published? %>
<%= form.button name: "post[status]", value: "draft", **hotkey_options(("d" unless published), class: "btn-optional", **(published ? {} : save_shortcut_options)) do %>
  <span class="sm:hidden"><%= draft_button_text(record, short: true) %></span>
  <span class="hidden sm:inline"><%= draft_button_text(record) %></span>
  <%= hotkey "d" unless published %>
<% end %>
