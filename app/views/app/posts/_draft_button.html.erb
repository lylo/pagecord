<%# locals: (form:, record:) %>
<% saves = !editing_published?(record) %>
<%= form.button name: "post[status]", value: "draft", **save_button_options("d", saves: saves, class: "btn-optional") do %>
  <span class="sm:hidden"><%= draft_button_text(record, short: true) %></span>
  <span class="hidden sm:inline"><%= draft_button_text(record) %></span>
  <%= hotkey "d" if saves %>
<% end %>
