<div class="sheet-header justify-between gap-x-3">
  <div class="flex items-center gap-x-2 min-w-0">
    <%= link_to "Posts", app_posts_path, class: "font-semibold text-slate-800 dark:text-slate-100 hover:underline" %>
    <span class="text-slate-400">&rsaquo;</span>
    <span class="truncate">Tags</span>
  </div>
  <%= render "app/shared/help/tags" %>
</div>

<div class="mt-6 flex items-center gap-3">
  <h1 class="page-title">Manage your tags</h1>
  <%= pill @tag_counts.size, class: "mt-1" %>
</div>

<div class="sheet-divider mt-5"></div>

<div class="divide-y divide-slate-200 dark:divide-slate-800">
  <% if @tag_counts.empty? %>
    <p class="py-8 text-center text-slate-600 dark:text-slate-300">
      You haven't tagged any posts yet.
    </p>
  <% else %>
    <% @tag_counts.each do |tag, count| %>
      <div class="group sheet-bleed flex items-center gap-3 py-5 hover:bg-slate-50 dark:hover:bg-slate-800/60" data-controller="inline-edit">
        <div class="flex min-w-0 flex-1 items-baseline gap-x-2" data-inline-edit-target="display">
          <span class="font-medium [overflow-wrap:anywhere] text-slate-900 dark:text-slate-100" data-action="dblclick->inline-edit#edit"><%= tag %></span>
          <%= link_to pluralize(count, "post"), app_posts_path(tag: tag), class: "link-quiet shrink-0 text-sm text-slate-500 dark:text-slate-400", title: "Find posts tagged #{tag}" %>
        </div>

        <%= form_with url: app_posts_tag_path(tag), method: :patch, class: "hidden min-w-0 flex-1", data: { inline_edit_target: "form" } do %>
          <div class="flex items-center justify-between gap-2">
            <%= text_field_tag :new_name, tag, "aria-label": "Rename #{tag}", class: "w-full min-w-0 max-w-56 border-0 bg-transparent p-0 font-medium text-slate-900 focus:outline-none focus:ring-0 dark:text-slate-100", data: { inline_edit_target: "input", action: "keydown.esc->inline-edit#cancel" } %>
            <div class="flex shrink-0 items-center gap-2">
              <%= submit_tag "Save", class: "btn-primary py-1", data: { disable_with: false } %>
              <button type="button" class="cursor-pointer text-sm text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200" data-action="inline-edit#cancel">Cancel</button>
            </div>
          </div>
        <% end %>

        <div class="flex min-h-7 shrink-0 items-center gap-1 text-slate-400 group-hover:text-slate-500 dark:text-slate-400 dark:group-hover:text-slate-300" data-inline-edit-target="display">
          <button type="button" class="cursor-pointer p-1 transition-colors hover:text-slate-700 dark:hover:text-slate-200" title="Rename <%= tag %>" aria-label="Rename <%= tag %>" data-action="inline-edit#edit">
            <%= inline_svg_tag "icons/edit.svg", class: "w-4 h-4" %>
          </button>

          <%= button_to app_posts_tag_path(tag), method: :delete, data: { turbo_confirm: "Remove #{tag} from #{pluralize(count, 'post')}? This cannot be undone." }, title: "Remove #{tag}", aria: { label: "Remove #{tag}" }, class: "cursor-pointer p-1 transition-colors hover:text-red-600" do %>
            <%= inline_svg_tag "icons/trash.svg", class: "w-4 h-4" %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

