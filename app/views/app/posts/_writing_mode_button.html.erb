<%# locals: (exit: false) %>
<% classes = "flex h-7 w-7 cursor-pointer items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:text-slate-500 dark:hover:bg-slate-800 dark:hover:text-slate-200" %>
<% if exit %>
  <button type="button" class="fixed top-4 right-4 z-30 hidden writing-mode:flex <%= classes %>" title="Exit writing mode (Esc)" data-action="mousedown->writing-mode#toggle:prevent">
    <%= inline_svg_tag "icons/collapse.svg", class: "w-6 h-6 shrink-0" %>
  </button>
<% else %>
  <button type="button" class="<%= classes %>" title="Writing mode (⌘⇧F)" data-action="mousedown->writing-mode#toggle:prevent">
    <%= inline_svg_tag "icons/expand.svg", class: "w-6 h-6 shrink-0" %>
  </button>
<% end %>
