<% quiet_link = "link-quiet font-medium hover:text-slate-800 dark:hover:text-slate-200" %>
<div class="relative isolate flex grow flex-col items-center pt-10 pb-12 text-center sm:pt-16">
  <div class="paper-sheet w-60 -rotate-2 px-7 pt-7 pb-9 text-start sm:w-72" aria-hidden="true">
    <p class="font-hand text-4xl font-bold leading-none text-pagecord-accent-deep">hello, world</p>
    <div class="mt-5 space-y-3">
      <div class="paper-sheet__rule"></div>
      <div class="paper-sheet__rule"></div>
      <div class="paper-sheet__rule w-2/3"></div>
    </div>
  </div>

  <h2 class="mt-12 text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">Write your first post</h2>
  <p class="mt-2 max-w-sm text-slate-600 dark:text-slate-300">
    Your blog is live at <%= link_to @blog.host, blog_home_url(@blog), target: "_blank", class: quiet_link %>. Ready when you are!
  </p>

  <%= render "new_post_button", icon: true, css: "mt-6" %>

  <%= render "app/shared/first_steps" %>
</div>
