<%# locals: (record:, label:) %>
<button type="button" class="relative flex h-7 w-7 cursor-pointer items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:text-slate-500 dark:hover:bg-slate-800 dark:hover:text-slate-200" title="<%= label %> (⌘.)" data-action="settings-panel#toggle">
  <%= inline_svg_tag "icons/cog.svg", class: "w-6 h-6 shrink-0" %>
  <% if settings_customised?(record) %>
    <span class="absolute -top-0.5 -right-0.5 h-2 w-2 rounded-full bg-pagecord-accent ring-2 ring-white dark:ring-slate-900"></span>
  <% end %>
</button>
