<div class="flex grow flex-col" data-controller="keyboard-shortcuts" data-keyboard-shortcuts-shortcuts-value="<%= { c: new_app_post_path }.to_json %>">
  <% if @posts.empty? && @drafts.empty? && @search_term.blank? && @tag.blank? %>
    <%= render "blank_slate" %>
  <% else %>
    <% filter = { search: @search_term.presence, tag: @tag.presence } %>

    <div data-controller="search">
      <div class="sheet-header justify-between gap-x-3">
        <%= render "app/shared/blog_link" %>

        <div class="flex items-center gap-x-1">
          <button data-action="click->search#toggle" class="btn-icon" title="Search posts" aria-label="Search posts">
            <%= inline_svg_tag "icons/search.svg", class: "w-5 h-5" %>
          </button>

          <%= link_to app_posts_tags_path, class: "btn-icon", title: "Manage tags", aria: { label: "Manage tags" } do %>
            <%= inline_svg_tag "icons/tag.svg", class: "w-5 h-5" %>
          <% end %>
        </div>
      </div>

      <h1 class="mt-6 text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Posts</h1>

      <div class="mt-3 flex flex-wrap items-center gap-2">
        <%= link_to "New Post", new_app_post_path, class: "btn-primary", title: "Start writing a new post" %>

        <div class="btn-group">
          <%= button_to app_posts_tab_path, method: :patch, params: filter.merge(tab: "published"),
                class: class_names("btn-group-item", "btn-group-item-active": @tab == "published") do %>
            Published <%= pill @posts_count %>
          <% end %>
          <%= button_to app_posts_tab_path, method: :patch, params: filter.merge(tab: "drafts"),
                class: class_names("btn-group-item", "btn-group-item-active": @tab == "drafts") do %>
            Drafts <%= pill @drafts_count %>
          <% end %>
        </div>

        <div class="ms-auto"><%= render "info_toggle" %></div>
      </div>

      <div data-search-target="container" class="pt-4 <%= 'hidden' unless @search_term %>">
        <%= form_with url: app_posts_path, method: :get, local: true, data: { turbo_frame: "posts", search_target: "form", turbo_action: "advance" } do |form| %>
          <div class="relative">
            <%= form.text_field :search, value: @search_term, placeholder: "Search posts...",
                data: { action: "input->search#search keydown->search#handleKeydown", search_target: "input" },
                class: "form-field w-full px-4 py-2 pr-12" %>
            <button type="button" data-action="click->search#toggle" class="absolute right-3 top-1/2 -translate-y-1/2 transform text-slate-400 transition-colors hover:text-slate-600 dark:hover:text-slate-300" title="Close search" aria-label="Close search">
              <%= inline_svg_tag "icons/close.svg", class: "w-5 h-5" %>
            </button>
          </div>
        <% end %>
      </div>
    </div>

    <div class="sheet-divider mt-5"></div>

    <%= turbo_frame_tag "posts", data: { turbo_action: "advance" } do %>
      <%= render "posts_list" %>
      <%= render "app/shared/pagy_nav" if @tab == "published" %>
    <% end %>
  <% end %>

  <% trashed_count = @blog.posts.discarded.count %>
  <% if trashed_count > 0 %>
    <div class="sheet-divider mt-auto pt-5">
      <%= link_to app_posts_trash_path, class: "inline-flex items-center gap-1.5 text-sm text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300" do %>
        <%= inline_svg_tag "icons/trash.svg", class: "w-3.5 h-3.5" %>
        <%= pluralize trashed_count, "deleted post" %>
      <% end %>
    </div>
  <% end %>
</div>
