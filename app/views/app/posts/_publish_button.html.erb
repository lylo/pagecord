<%# locals: (form:, record:, model_name: nil) %>
<% saves = editing_published?(record) %>
<%= form.button **save_button_options("u", saves: saves, class: "btn-primary") do %>
  <span class="sm:hidden"><%= publish_button_text(record, model_name: model_name, short: true) %></span>
  <span class="hidden sm:inline"><%= publish_button_text(record, model_name: model_name) %></span>
  <%= hotkey "u" if saves %>
<% end %>
