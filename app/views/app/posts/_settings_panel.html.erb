<%# locals: (form:) %>
<div class="group" data-settings-panel-target="panel">
  <div class="fixed inset-0 z-40 bg-slate-950/25 dark:bg-slate-950/60 invisible opacity-0 transition-all duration-200 motion-reduce:transition-none group-data-open:visible group-data-open:opacity-100" data-action="click->settings-panel#close"></div>
  <div class="fixed z-50 inset-x-0 bottom-0 max-h-[85vh] rounded-t-2xl sm:inset-y-0 sm:inset-x-auto sm:right-0 sm:w-[400px] sm:max-h-none sm:rounded-none overflow-y-auto bg-white dark:bg-slate-900 dark:border-t dark:sm:border-t-0 dark:sm:border-l dark:border-slate-700 shadow-xl invisible translate-y-full sm:translate-y-0 sm:translate-x-full transition-all duration-200 ease-out motion-reduce:transition-none group-data-open:visible group-data-open:translate-y-0 group-data-open:translate-x-0">
    <div class="sticky top-0 z-10 flex items-center justify-between px-6 py-4 bg-slate-100 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
      <h2 class="text-lg font-bold">Post settings</h2>
      <button type="button" class="text-slate-500 cursor-pointer hover:text-black dark:text-slate-300 dark:hover:text-slate-50" title="Close (Esc)" data-action="settings-panel#close">
        <%= inline_svg_tag "icons/close.svg", class: "w-5 h-5" %>
      </button>
    </div>
    <div class="px-6 pb-4">
    <div class="mb-8" data-section="tags">
      <div class="mt-4 font-bold">
        <%= form.label :tags_string, "Tags" %>
      </div>

      <div class="mt-2" data-controller="tags-input" data-tags-input-suggestions-value="<%= @blog.all_posts.kept.all_tags.to_json %>">
        <%= form.text_field :tags_string,
            class: "w-full",
            data: {
              tags_input_target: "input",
              action: "change->settings-panel#refreshTags"
            } %>

        <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Type a tag and press enter to add it. Use letters, numbers, and hyphens only.
        </div>
      </div>
    </div>

    <div class="mb-8" data-section="published-at">
      <div class="mt-4 font-bold">
      <%= form.label :published_at, "Publication Time" %>
      </div>

      <div class="mt-2">
      <%= form.datetime_field :published_at,
          value: @post.published_at&.strftime('%Y-%m-%dT%H:%M'),
          class: "w-full dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-200 rounded-lg" %>
      </div>
    </div>

    <div class="mb-8" data-section="slug">
      <div class="mt-4 font-bold">
      <%= form.label :slug, "Slug" %>
      </div>

      <fieldset class="mt-2">
        <%= form.text_field :slug,
            class: "w-full placeholder-slate-300 dark:placeholder-slate-600 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-slate-200 rounded-lg",
            placeholder: "custom-url-path" %>
        <div class="field-error"><%= @post.errors[:slug].to_sentence if @post.errors[:slug].any? %></div>
      </fieldset>
    </div>

    <div class="mb-8" data-section="visibility">
      <div class="mt-4 font-bold">
        Post Visibility
      </div>

      <div class="mt-4 flex gap-3">
        <div class="flex h-6 shrink-0 items-center">
          <%= form.check_box :hidden, class: "form-checkbox h-5 w-5 text-slate-600 border-slate-300 dark:border-slate-600 dark:bg-slate-700 rounded focus:ring focus:ring-slate-300 dark:focus:ring-slate-600 focus:ring-offset-0" %>
        </div>
        <div>
          <%= form.label :hidden, "Hide this post on my blog", class: "text-sm text-slate-800 dark:text-slate-100" %>
          <p class="text-slate-500 text-sm">
            When checked, this post will not be visible on your blog, but it can accessed via it's link.
          </p>
        </div>
      </div>
    </div>

    <div class="mb-8" data-section="canonical-url">
      <div class="mt-4 font-bold">
      <%= form.label :canonical_url, "Canonical URL" %>
      </div>

      <div class="mt-2">
      <%= form.text_field :canonical_url, class: "w-full placeholder-slate-300 dark:placeholder-slate-600 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 text-slate-800 dark:text-slate-200 rounded-lg", placeholder: "https://example-canonical-url.com" %>
      </div>
    </div>

    <% if @blog.accepts_comments? %>
      <div class="mb-8" data-section="comments">
        <div class="mt-4 font-bold">
          Comments
        </div>

        <div class="mt-4 flex gap-3">
          <div class="flex h-6 shrink-0 items-center">
            <%= form.check_box :comments_closed, class: "form-checkbox h-5 w-5 text-slate-600 border-slate-300 dark:border-slate-600 dark:bg-slate-700 rounded focus:ring focus:ring-slate-300 dark:focus:ring-slate-600 focus:ring-offset-0" %>
          </div>
          <div>
            <%= form.label :comments_closed, "Close comments on this post", class: "text-sm text-slate-800 dark:text-slate-100" %>
            <p class="text-slate-500 text-sm">
              <% if @post.comments_count.positive? %>
                Readers won't be able to add any more. The <%= pluralize @post.comments_count, "comment" %> already published will stay visible.
              <% else %>
                Readers won't be able to comment, and no comment box will appear on this post.
              <% end %>
            </p>
          </div>
        </div>
      </div>
    <% end %>

    <%= render "app/posts/open_graph_image_section", record: @post, form: form, revealed: true %>

    <div class="mb-8" data-section="locale">
      <div class="mt-4 font-bold">
        <%= form.label :locale, "Post Language" %>
      </div>
      <div class="mt-2">
        <%= form.select :locale,
            Post.available_locales,
            { include_blank: "Use blog default (#{Post.locale_name(@post.blog.locale)})" },
            class: "w-full dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-200 rounded-lg" %>
      </div>
    </div>

    <div class="mt-8 pt-6 pb-4 border-t border-slate-200 dark:border-slate-700 flex justify-between gap-x-2">
      <% if @post.persisted? %>
        <%= link_to "Delete post", app_posts_trash_path(post_token: @post.token), class: "btn-danger", data: { turbo_method: :post, turbo_confirm: "Are you sure you want to delete this post?" } %>
      <% end %>
      <button type="button" class="btn-optional ms-auto sm:hidden" data-action="settings-panel#close">Done</button>
    </div>
    </div>
  </div>
</div>
