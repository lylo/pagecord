<% subscriber_count = @blog.email_subscribers.confirmed.count %>
<% if @post.individually_sent? %>
  <% digest = @post.post_digests.individual.first %>
  <div class="sheet-top-band writing-mode:hidden relative overflow-hidden py-6 text-sm text-slate-700 dark:text-slate-300">
    <div class="pointer-events-none absolute inset-y-0 end-0 flex items-center">
      <%= inline_svg_tag "icons/stamp.svg", class: "h-14 w-auto text-pagecord-accent/30 dark:text-pagecord-accent/25 rotate-[-5deg]" %>
    </div>
    <div class="relative flex items-center gap-2">
      <%= inline_svg_tag "icons/envelope.svg", class: "w-4 h-4 text-pagecord-accent shrink-0" %>
      <% count = digest.delivered_at? ? digest.deliveries.count : subscriber_count %>
      <% recipients = @blog.show_metrics? ? pluralize(count, "subscriber") : "subscribers" %>
      <span>Emailed to <%= recipients %> on <%= l(digest.created_at.in_time_zone(Current.user.timezone).to_date, format: :post_date) %>.</span>
    </div>
  </div>
<% elsif @blog.individual? && (digest = @post.post_digests.weekly_digest.first) %>
  <div class="sheet-top-band writing-mode:hidden py-4 text-sm text-slate-500 dark:text-slate-400">
    <div class="flex items-center gap-2">
      <%= inline_svg_tag "icons/envelope.svg", class: "w-4 h-4 text-slate-400 dark:text-slate-500 shrink-0" %>
      <span>Included in the weekly digest on <%= l(digest.created_at.in_time_zone(Current.user.timezone).to_date, format: :post_date) %>.</span>
    </div>
  </div>
<% elsif @post.individually_sendable? && !Current.user.individual_send_allowed? %>
  <div class="sheet-top-band writing-mode:hidden py-6 text-sm bg-amber-50 text-amber-900 dark:bg-amber-950/40 dark:text-amber-100">
    <div class="flex items-center gap-2">
      <%= inline_svg_tag "icons/alert-triangle.svg", class: "w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0" %>
      <span><strong class="font-medium">Monthly email limit reached.</strong> You can send this post from <%= l(Current.user.next_individual_send_at, format: "%-d %B") %>.</span>
    </div>
  </div>
<% elsif @post.individually_sendable? %>
  <div class="sheet-top-band writing-mode:hidden py-4 text-sm text-slate-700 dark:text-slate-300">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-2">
        <%= inline_svg_tag "icons/envelope.svg", class: "w-4 h-4 text-slate-400 dark:text-slate-500 shrink-0" %>
        <span>Send this post to your <%= @blog.show_metrics? ? pluralize(subscriber_count, "subscriber") : "subscribers" %>.</span>
      </div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <%= link_to "Send a test email", app_post_broadcast_test_path(@post), data: { turbo_method: :post, turbo_confirm: "Send a test email to #{Current.user.email}?" }, class: "link-quiet text-slate-600 dark:text-slate-300" %>
        <%= button_to app_post_broadcast_path(@post),
          method: :post,
          class: "btn-secondary",
          form_class: "contents",
          data: { turbo_confirm: "Send this post to all your email subscribers?" } do %>
          <%= inline_svg_tag "icons/paper-airplane.svg", class: "w-4 h-4" %>
          <span class="ms-2">Send</span>
        <% end %>
      </div>
    </div>
  </div>
<% elsif @post.send_window_closed? %>
  <div class="sheet-top-band writing-mode:hidden py-4 text-sm text-slate-500 dark:text-slate-400">
    <div class="flex items-center gap-2">
      <%= inline_svg_tag "icons/envelope.svg", class: "w-4 h-4 text-slate-400 dark:text-slate-500 shrink-0" %>
      <span>Posts can be emailed to subscribers within <%= pluralize(Post::SEND_WINDOW.in_days.to_i, "day") %> of their publish date.</span>
    </div>
  </div>
<% end %>
