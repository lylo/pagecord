<% filtering = @search_term.present? || @tag.present? %>

<% if filtering && @posts.empty? && @drafts.empty? %>
  <p class="py-8 text-center text-slate-600 dark:text-slate-300">No posts found for "<%= @search_term.presence || @tag %>"</p>
<% else %>
  <% if filtering %>
    <p class="pt-4 text-sm text-slate-500 dark:text-slate-400">
      <%= pluralize(@tab == "drafts" ? @drafts.size : @pagy.count, @tab == "drafts" ? "draft" : "post") %>
      <% if @tag.present? %>
        tagged <span class="font-medium text-slate-700 dark:text-slate-200">#<%= @tag %></span> ·
        <%= link_to "Clear", app_posts_path, class: "link-quiet" %>
      <% else %>
        matching "<%= @search_term %>"
      <% end %>
    </p>
  <% end %>

  <% if @tab == "drafts" %>
    <div id="draft_posts" class="pt-4 pb-4">
      <% @drafts.each do |post| %>
        <%= render "post", post: post, show_year: true %>
      <% end %>
      <% if @drafts.empty? %>
        <p class="py-6 text-center text-slate-600 dark:text-slate-300">No drafts.</p>
      <% end %>
    </div>
  <% else %>
    <div class="pt-4 pb-4">
      <% previous_year = nil %>
      <% @posts.each do |post| %>
        <% if post.published_at.year != previous_year %>
          <div class="mb-2 text-lg font-bold text-slate-900 dark:text-slate-100 <%= previous_year.nil? ? "mt-1" : "mt-8" %>">
            <%= post.published_at.year %>
            <% previous_year = post.published_at.year %>
          </div>
        <% end %>

        <%= render "post", post: post %>
      <% end %>
      <% if @posts.empty? %>
        <p class="py-6 text-center text-slate-600 dark:text-slate-300">Nothing published yet.</p>
      <% end %>
    </div>
  <% end %>
<% end %>
