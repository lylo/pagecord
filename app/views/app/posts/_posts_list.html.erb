<% if (@search_term.present? || @tag.present?) && @posts.empty? && @drafts.empty? %>
  <p class="py-8 text-center text-slate-600 dark:text-slate-300">No posts found for "<%= @search_term.presence || @tag %>"</p>
<% else %>
  <% filter = { search: @search_term.presence, tag: @tag.presence } %>
  <% published_title = @tag.presence || (@search_term.present? ? "Results" : "Published") %>

  <div class="sheet-band flex items-end justify-between gap-2 pt-2">
    <div class="flex gap-1">
      <%= button_to app_posts_tab_path, method: :patch, params: filter.merge(tab: "published"), form_class: "contents",
            class: class_names("tab", "tab-active": @tab == "published") do %>
        <%= published_title %> <%= pill @pagy.count %>
      <% end %>
      <%= button_to app_posts_tab_path, method: :patch, params: filter.merge(tab: "drafts"), form_class: "contents",
            class: class_names("tab", "tab-active": @tab == "drafts") do %>
        Drafts <%= pill @drafts.size %>
      <% end %>
    </div>
    <div class="pb-3"><%= render "info_toggle" %></div>
  </div>

  <% if @tab == "drafts" %>
    <div id="draft_posts" class="pt-4 pb-4">
      <% @drafts.each do |post| %>
        <%= render "post", post: post, show_year: true %>
      <% end %>
      <% if @drafts.empty? %>
        <p class="py-6 text-center text-slate-600 dark:text-slate-300">No drafts.</p>
      <% end %>
    </div>
  <% else %>
    <div class="pt-4 pb-4">
      <% previous_year = nil %>
      <% @posts.each do |post| %>
        <% if post.published_at.year != previous_year %>
          <div class="mb-2 text-lg font-bold text-slate-900 dark:text-slate-100 <%= previous_year.nil? ? "mt-1" : "mt-8" %>">
            <%= post.published_at.year %>
            <% previous_year = post.published_at.year %>
          </div>
        <% end %>

        <%= render "post", post: post %>
      <% end %>
      <% if @posts.empty? %>
        <p class="py-6 text-center text-slate-600 dark:text-slate-300">Nothing published yet.</p>
      <% end %>
    </div>
  <% end %>
<% end %>
