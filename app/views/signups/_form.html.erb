<% blog = @user.blogs.first %>
<% focus = @user.errors[:email].any? ? :email : (blog&.errors&.include?(:subdomain) ? :subdomain : :title) %>

<%= form_with url: signups_path, model: @user, class: "letter-form", data: { controller: "timezone signup-letter", turbo: "false" } do |form| %>
  <%= form.hidden_field :signup_referrer %>
  <%= form.hidden_field :timezone, data: { timezone_target: "timeZone" } %>
  <%= render "/shared/spam_prevention" %>


  <div class="letter-paper">
    <div class="letter-stamp" aria-hidden="true">
      <div class="letter-stamp__face">
        <span>PAGECORD</span>
        <span class="letter-stamp__cameo"><%= inline_svg_tag "logo-mark-crowned.svg" %></span>
        <span class="letter-stamp__code">1ST</span>
      </div>
    </div>

    <div class="letter-letterhead" aria-hidden="true">
      <%= inline_svg_tag "logo-mark-black.svg" %>
      <span>PAGECORD</span>
    </div>

    <p class="letter-date"><%= Date.current.strftime("%-d %B %Y") %></p>
    <p class="letter-note" role="alert"><%= @error_message %></p>

    <p>Dear Pagecord,</p>
    <p>
      I'd like a blog called
      <%= form.fields_for :blogs do |blog_form| %>
        <span class="letter-field">
          <%= blog_form.label :title, "Blog title", class: "sr-only" %>
          <%= blog_form.text_field :title,
              placeholder: "my blog title",
              maxlength: 100,
              required: true,
              autofocus: focus == :title,
              class: "letter-blank letter-blank--name",
              data: { signup_letter_target: "name", action: "input->signup-letter#nameChanged" } %>
        </span>
        <span class="letter-field">
          at
          <%= blog_form.label :subdomain, "Subdomain", class: "sr-only" %>
          <%= blog_form.text_field :subdomain,
              placeholder: "subdomain",
              maxlength: Subdomain::MAX_LENGTH,
              required: true,
              autofocus: focus == :subdomain,
              autocapitalize: "none",
              spellcheck: false,
              class: "letter-blank letter-blank--subdomain",
              data: { signup_letter_target: "subdomain", action: "input->signup-letter#subdomainChanged" } %><span>.pagecord.com.</span>
        </span>
      <% end %>
    </p>
    <p>
      You can reach me at
      <span class="letter-field">
        <%= form.label :email, "Email", class: "sr-only" %>
        <%= form.email_field :email, placeholder: "your email", required: true, autofocus: focus == :email, class: "letter-blank letter-blank--email" %><span class="letter-trail">.</span>
      </span>
    </p>
    <p class="letter-note" role="alert"><%= signup_note(@user) %></p>

    <p>Yours,</p>
    <p class="letter-signature" data-signup-letter-target="signature"><%= @user.blogs.first&.title %></p>

    <p class="letter-ps">
      P.S. I heard about Pagecord from
      <span class="letter-field">
        <%= form.label :signup_source_note, "How did you hear about Pagecord?", class: "sr-only" %>
        <%= form.text_field :signup_source_note, placeholder: "a friend, ChatGPT, Reddit… (optional)", maxlength: 500, class: "letter-blank letter-blank--source" %>
      </span>
    </p>

    <div class="letter-consent">
      <%= form.checkbox :marketing_consent %>
      <%= form.label :marketing_consent, "Send me the Pagecord newsletter, with updates and tips. Unsubscribe any time." %>
    </div>

    <div class="letter-send">
      <%= render "/shared/turnstile", theme: "auto", appearance: "interaction-only" %>
      <%= form.button type: "submit", class: "btn-primary" do %>
        Send my letter
        <%= inline_svg_tag "icons/paper-airplane.svg", class: "w-5 h-5" %>
      <% end %>
      <span>We'll email you a link to sign in.</span>
      <span>By signing up you agree to our <%= link_to "Terms", terms_path %> and <%= link_to "Privacy Policy", privacy_path %>.</span>
    </div>
  </div>
<% end %>
