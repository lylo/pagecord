<% blog = @user.blogs.first %>
<% focus = (@user.errors[:email].any? || (blog&.title.present? && blog.errors.none?)) ? :email : (blog&.errors&.include?(:subdomain) ? :subdomain : :title) %>

<%= form_with url: signups_path, model: @user, class: "letter-form", html: { autocomplete: "off" }, data: { controller: "timezone signup-letter signature", turbo: "false" } do |form| %>
  <%= form.hidden_field :signup_referrer %>
  <%= form.hidden_field :timezone, data: { timezone_target: "timeZone" } %>
  <%= render "/shared/spam_prevention" %>

  <div class="letter-paper">
    <%= render "letters/letterhead" %>
    <p class="letter-note" role="alert"><%= @region_paused ? render("region_paused") : @error_message %></p>

    <p>Dear Pagecord,</p>
    <p>
      I'd like a blog called
      <%= form.fields_for :blogs do |blog_form| %>
        <%= letter_blank blog_form, :title, label: "Blog title", placeholder: "my blog title", maxlength: 100, required: true, autofocus: focus == :title,
              data: { signup_letter_target: "name", signature_target: "source", action: "input->signup-letter#nameChanged input->signature#sign" } %>
        <%= letter_subdomain_blank blog_form, lead: "at", autofocus: focus == :subdomain,
              data: { signup_letter_target: "subdomain", action: "input->signup-letter#subdomainChanged" } %>
      <% end %>
    </p>
    <p>
      You can reach me at
      <%= letter_email_blank form, autocomplete: "off", autofocus: focus == :email %>
    </p>
    <p class="letter-note" role="alert"><%= signup_note(@user) %></p>

    <p>Yours,</p>
    <p class="letter-signature" data-signature-target="output"><%= blog&.title %></p>

    <p class="letter-ps">
      P.S. I heard about Pagecord from
      <%= letter_blank form, :signup_source_note, label: "How did you hear about Pagecord?", size: :source, placeholder: "a friend, ChatGPT, Reddit… (optional)", maxlength: 500 %>
    </p>

    <div class="letter-consent">
      <%= form.checkbox :marketing_consent %>
      <%= form.label :marketing_consent, "Send me the Pagecord newsletter, with updates and tips. Unsubscribe any time." %>
    </div>

    <div class="letter-send">
      <%= render "/shared/turnstile", theme: "auto", appearance: "interaction-only" %>
      <%= render "letters/send", form: form, label: "Send my letter" %>
      <span>We'll email you a link to sign in.</span>
      <span>By signing up you agree to our <%= link_to "Terms", terms_path %> and <%= link_to "Privacy Policy", privacy_path %>.</span>
    </div>
  </div>
<% end %>
