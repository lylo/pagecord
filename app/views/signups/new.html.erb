<% content_for :title, "Pagecord - Sign up" %>
<% content_for :meta_description, "Write to Pagecord and start your blog: a personal site and blog where you can focus on writing, not wrangling." %>
<% content_for :footer do %>Already writing on Pagecord? <%= link_to "Sign in", login_path %><% end %>

<% if ENV["DISABLE_SIGNUPS"] %>
  <div class="letter-intro">
    <h1>Signups are closed for now</h1>
    <p>Please check back later.</p>
  </div>
<% else %>
  <% if Invitation.required? %>
    <div class="letter-intro">
      <h1>Pagecord is invite-only right now</h1>
      <p>To keep the spammers out.</p>
    </div>
  <% end %>

  <%= render "form" %>
<% end %>
