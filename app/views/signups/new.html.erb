<% content_for :title, "Pagecord - Sign up" %>
<% content_for :meta_description, "Create your free Pagecord account. Start blogging in seconds." %>
<% content_for :footer do %>Already writing on Pagecord? <%= link_to "Sign in", login_path %><% end %>

<% if ENV["DISABLE_SIGNUPS"] %>
  <div class="letter-intro">
    <h1>Signups are closed for now</h1>
    <p>Please check back later.</p>
  </div>
<% else %>
  <%= render "form" %>
<% end %>
